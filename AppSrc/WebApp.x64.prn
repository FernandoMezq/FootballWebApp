38924>>>    Procedure SetActionButtons
38927>>>        tWebNavigateData NavigateData
38927>>>        tWebNavigateData NavigateData
38927>>>        Boolean bHasRecord
38927>>>        Handle hoDD
38927>>>
38927>>>        Get Server to hoDD
38928>>>        Get GetNavigateData to NavigateData
38929>>>        Get HasRecord of hoDD to bHasRecord
38930>>>
38930>>>        // let's hide all buttons and then Show the ones we want
38930>>>        WebSet pbRender of oEditBtn to False
38931>>>        WebSet pbRender of oSaveBtn to False
38932>>>        WebSet pbRender of oCancelChangesBtn to False
38933>>>        WebSet pbRender of oDeleteBtn to False
38934>>>
38934>>>        If (NavigateData.bReadOnly) Begin
38936>>>            WebSet pbRender of oEditBtn to True
38937>>>        End
38937>>>>
38937>>>        Else Begin
38938>>>            WebSet pbRender of oSaveBtn to True
38939>>>            WebSet pbRender of oCancelChangesBtn to True
38940>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38941>>>        End
38941>>>>
38941>>>    End_Procedure
38942>>>
38942>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
38945>>>        // Close after save
38945>>>        Send NavigateClose Self
38946>>>    End_Procedure
38947>>>
38947>>>    // this will close the view after a delete
38947>>>    Procedure OnViewDeleted Handle hoDDO
38950>>>        Send NavigateClose Self
38951>>>    End_Procedure
