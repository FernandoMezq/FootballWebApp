37257>>>    Procedure DoLogin
37260>>>        String sLoginName sPassword sPrevStateHash
37260>>>        Boolean bResult
37260>>>        
37260>>>        WebGet psValue of oLoginName to sLoginName
37261>>>        WebGet psValue of oPassword to sPassword
37262>>>        
37262>>>        Get UserLogin of ghoWebSessionManager sLoginName sPassword to bResult
37263>>>        
37263>>>        If (bResult) Begin
37265>>>            Send Hide of oLogin
37266>>>            Send ShowHeader of ghoWebApp
37267>>>            WebSet psCSSClass of ghoWebApp to ""
37268>>>            
37268>>>            WebGet psPrevStateHash to sPrevStateHash
37269>>>            Send NavigateToStateHash of ghoWebApp sPrevStateHash True
37270>>>            
37270>>>            
37270>>>            WebSet psValue of oLoginName to ""
37271>>>            WebSet psValue of oPassword  to ""
37272>>>            WebSet pbVisible of oWarning to False
37273>>>        End
37273>>>>
37273>>>        Else Begin
37274>>>            WebSet pbVisible of oWarning to True
37275>>>        End
37275>>>>
37275>>>    End_Procedure
