37987>>>                // If from main, this is a propbably a main file Select to Zoom.
37987>>>                Case Break
37988>>>
37988>>>            Case (NavigateData.eNavigateType = nfFromParent)
37991>>>                // If from parent, this is a constrained drill down.
37991>>>                Case Break
37992>>>
37992>>>            Case (NavigateData.eNavigateType = nfFromChild)
37995>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37995>>>                Case Break
37996>>>
37996>>>            Case Else // must be nfUndefined
37996>>>
37996>>>        Case End
37996>>>
37996>>>        Send SetActionButtons
37997>>>
37997>>>    End_Procedure
37998>>>
37998>>>End_Object 
