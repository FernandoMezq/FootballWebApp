36704>>>>>>>                Get CNG_PBKDF2_HMAC "SHA512" (StringToUCharArray(sPassword)) ucaSalt uiOptTimeCost (&ucaHash) False to bOk
36705>>>>>>>                If (not(bOk)) Function_Return False
36708>>>>>>>                
36708>>>>>>>                Move True to bRequireTimeCost
36709>>>>>>>                Case Break
36710>>>>>>>            Case Else
36710>>>>>>>                Error 8710 "Invalid algorithm selected."
36711>>>>>>>>
36711>>>>>>>                Function_Return False
36712>>>>>>>        Case End
36712>>>>>>>        
36712>>>>>>>        String sSalt
36712>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
36713>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return False
36716>>>>>>>        Get Base64EncodeArr ucaHash to sHash
36717>>>>>>>        If (not(SizeOfString(sHash))) Function_Return False
36720>>>>>>>        
36720>>>>>>>        If (bRequireTimeCost) Begin
36722>>>>>>>            Move (SFormat("%1$%2$%3$%4",            ;                            String(uiAlgo),         ;                            sSalt,                  ;                            String(uiOptTimeCost),  ;                            sHash)) to sHash
36723>>>>>>>        End
36723>>>>>>>>
36723>>>>>>>        Else Begin
36724>>>>>>>            Move (SFormat("%1$%2$%3",               ;                            String(uiAlgo),         ;                            sSalt,                  ;                            sHash)) to sHash
36725>>>>>>>        End
36725>>>>>>>>
36725>>>>>>>        
36725>>>>>>>        Function_Return bOk
36726>>>>>>>    End_Function
36727>>>>>>>    
36727>>>>>>>    Function CreatePasswordHashEx UInteger uiAlgo UInteger uiSaltSize String sPassword String ByRef sHash UInteger uiOptTimeCost Returns Boolean
36729>>>>>>>        UChar[] ucaSalt
36730>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36731>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36734>>>>>>>        
36734>>>>>>>        If (num_arguments > 4) Begin
36736>>>>>>>            Function_Return (CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sHash, uiOptTimeCost))
36737>>>>>>>        End
36737>>>>>>>>
36737>>>>>>>        Function_Return (CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sHash))
36738>>>>>>>    End_Function
36739>>>>>>>    
36739>>>>>>>    Function VerifyPasswordHash String sPassword String sHash Returns Boolean
36741>>>>>>>        Boolean bRequiresTimeCost
36741>>>>>>>        UInteger uiAlgo uiTimeCost
36741>>>>>>>        Integer iBegin iEnd
36741>>>>>>>        String sSalt
36741>>>>>>>        
36741>>>>>>>        Move 1 to iBegin
36742>>>>>>>        
36742>>>>>>>        // Parse Algo
36742>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36743>>>>>>>        If (not(iEnd)) Function_Return False
36746>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiAlgo
36747>>>>>>>        
36747>>>>>>>        // Parse Salt
36747>>>>>>>        Move (iEnd + 1) to iBegin
36748>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36749>>>>>>>        If (not(iEnd)) Function_Return False
36752>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to sSalt
36753>>>>>>>        
36753>>>>>>>        Case Begin
36753>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36755>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36758>>>>>>>                Move True to bRequiresTimeCost
36759>>>>>>>                Case Break
36760>>>>>>>            Case Else
36760>>>>>>>                Error 8710 "Invalid algorithm selected."
36761>>>>>>>>
36761>>>>>>>                Function_Return False
36762>>>>>>>        Case End
36762>>>>>>>        
36762>>>>>>>        // Parse optional timecost
36762>>>>>>>        If (bRequiresTimeCost) Begin
36764>>>>>>>            Move (iEnd + 1) to iBegin
36765>>>>>>>            Move (Pos("$", sHash, iBegin)) to iEnd
36766>>>>>>>            If (not(iEnd)) Function_Return False
36769>>>>>>>            Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiTimeCost
36770>>>>>>>        End
36770>>>>>>>>
36770>>>>>>>        
36770>>>>>>>        // Parse rest hash
36770>>>>>>>        Move (iEnd + 1) to iBegin
36771>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36772>>>>>>>        If (iEnd) Function_Return False // inverse check if there are any other errors.
36775>>>>>>>        
36775>>>>>>>        // Base64Decode
36775>>>>>>>        UChar[] ucaSalt
36776>>>>>>>        Get Base64DecodeArr sSalt to ucaSalt
36777>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36780>>>>>>>        
36780>>>>>>>        // Create new hash
36780>>>>>>>        String sNewHash
36780>>>>>>>        If (bRequiresTimeCost) Begin
36782>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash, uiTimeCost))) Begin
36784>>>>>>>                Function_Return False 
36785>>>>>>>            End
36785>>>>>>>>
36785>>>>>>>        End
36785>>>>>>>>
36785>>>>>>>        Else Begin
36786>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash))) Begin
36788>>>>>>>                Function_Return False 
36789>>>>>>>            End
36789>>>>>>>>
36789>>>>>>>        End
36789>>>>>>>>
36789>>>>>>>        Function_Return (sNewHash = sHash)
36790>>>>>>>    End_Function
36791>>>>>>>    
36791>>>>>>>    Function RequiredBufferSizeEx UInteger uiAlgo UInteger uiSaltSize UInteger uiOptTimeCost Returns UBigInt
36793>>>>>>>        Boolean bRequireTimeCost
36793>>>>>>>        UBigInt ullSize
36793>>>>>>>        UChar[] ucaSalt
36794>>>>>>>        String sSalt
36794>>>>>>>        
36794>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36795>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
36796>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return 0
36799>>>>>>>        
36799>>>>>>>        Case Begin
36799>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36801>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA256" to ullSize
36802>>>>>>>                Move True to bRequireTimeCost
36803>>>>>>>                Case Break
36804>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36807>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA512" to ullSize
36808>>>>>>>                Move True to bRequireTimeCost
36809>>>>>>>                Case Break
36810>>>>>>>            Case Else
36810>>>>>>>                Error 8710 "Invalid algorithm selected."
36811>>>>>>>>
36811>>>>>>>                Function_Return 0
36812>>>>>>>        Case End
36812>>>>>>>        
36812>>>>>>>        // calculate base64 in a non-floating-manner
36812>>>>>>>        Move (((ullSize + 3 -1) / 3) * 4) to ullSize
36813>>>>>>>        
36813>>>>>>>        Move (ullSize + SizeOfString(String(uiAlgo))) to ullSize
36814>>>>>>>        Move (ullSize + SizeOfString(sSalt)) to ullSize
36815>>>>>>>        If (bRequireTimeCost) Begin
36817>>>>>>>            Move (ullSize + SizeOfString(String(uiOptTimeCost))) to ullSize
36818>>>>>>>            Move (ullSize + 3 /*$*/) to ullSize
36819>>>>>>>        End
36819>>>>>>>>
36819>>>>>>>        Else Begin
36820>>>>>>>            Move (ullSize + 2 /*$*/) to ullSize
36821>>>>>>>        End
36821>>>>>>>>
36821>>>>>>>        
36821>>>>>>>        Function_Return ullSize
36822>>>>>>>    End_Function
36823>>>>>>>End_Class
36824>>>>>>>
36824>>>>>>>Class cPasswordHasher is a cObject
36825>>>>>>>    
36825>>>>>>>    Import_Class_Protocol cPasswordHasher_Mixin
36826>>>>>>>    
36826>>>>>>>    Procedure Construct_Object
36828>>>>>>>        Forward Send Construct_Object
36830>>>>>>>        
36830>>>>>>>        Property UInteger   peAlgorithm         C_PWH_PBKDF2_HMAC_SHA_512 
36831>>>>>>>        Property UInteger   puiSaltSize         16
36832>>>>>>>        
36832>>>>>>>        Property UInteger   puiOptTimeCost      420000
36833>>>>>>>    End_Procedure
36834>>>>>>>    
36834>>>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
36836>>>>>>>        Boolean bOk
36836>>>>>>>        UInteger uiAlgo
36836>>>>>>>        Get peAlgorithm to uiAlgo
36837>>>>>>>        
36837>>>>>>>        Case Begin
36837>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36839>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36842>>>>>>>                Get CreatePasswordHashEx uiAlgo (puiSaltSize(Self)) sPassword (&sHash) (puiOptTimeCost(Self)) to bOk
36843>>>>>>>                Case Break
36844>>>>>>>            Case Else
36844>>>>>>>                Error 8710 "Invalid algorithm selected."
36845>>>>>>>>
36845>>>>>>>                Function_Return False
36846>>>>>>>        Case End
36846>>>>>>>        
36846>>>>>>>        Function_Return bOk
36847>>>>>>>    End_Function
36848>>>>>>>    
36848>>>>>>>    Function RequiredBufferSize Returns UBigInt
36850>>>>>>>        UBigInt ullSize
36850>>>>>>>        UInteger uiAlgo
36850>>>>>>>        Get peAlgorithm to uiAlgo
36851>>>>>>>        
36851>>>>>>>        Case Begin
36851>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36853>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36856>>>>>>>                Get RequiredBufferSizeEx uiAlgo (puiSaltSize(Self)) (puiOptTimeCost(Self)) to ullSize
36857>>>>>>>                Case Break
36858>>>>>>>            Case Else
36858>>>>>>>                Error 8710 "Invalid algorithm selected."
36859>>>>>>>>
36859>>>>>>>                Function_Return 0
36860>>>>>>>        Case End
36860>>>>>>>        
36860>>>>>>>        Function_Return ullSize
36861>>>>>>>    End_Function
36862>>>>>>>
36862>>>>>>>End_Class
