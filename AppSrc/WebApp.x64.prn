37602>>>    Procedure SetActionButtons
37605>>>        tWebNavigateData NavigateData
37605>>>        tWebNavigateData NavigateData
37605>>>        Boolean bHasRecord
37605>>>        Handle hoDD
37605>>>
37605>>>        Get Server to hoDD
37606>>>        Get GetNavigateData to NavigateData
37607>>>        Get HasRecord of hoDD to bHasRecord
37608>>>
37608>>>        // let's hide all buttons and then Show the ones we want
37608>>>        WebSet pbRender of oEditBtn to False
37609>>>        WebSet pbRender of oSaveBtn to False
37610>>>        WebSet pbRender of oCancelChangesBtn to False
37611>>>        WebSet pbRender of oDeleteBtn to False
37612>>>
37612>>>        If (NavigateData.bReadOnly) Begin
37614>>>            WebSet pbRender of oEditBtn to True
37615>>>        End
37615>>>>
37615>>>        Else Begin
37616>>>            WebSet pbRender of oSaveBtn to True
37617>>>            WebSet pbRender of oCancelChangesBtn to True
37618>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37619>>>        End
37619>>>>
37619>>>    End_Procedure
