36687>>>>>>>            Move (SFormat("%1$%2$%3$%4",            ;                            String(uiAlgo),         ;                            sSalt,                  ;                            String(uiOptTimeCost),  ;                            sHash)) to sHash
36688>>>>>>>        End
36688>>>>>>>>
36688>>>>>>>        Else Begin
36689>>>>>>>            Move (SFormat("%1$%2$%3",               ;                            String(uiAlgo),         ;                            sSalt,                  ;                            sHash)) to sHash
36690>>>>>>>        End
36690>>>>>>>>
36690>>>>>>>        
36690>>>>>>>        Function_Return bOk
36691>>>>>>>    End_Function
