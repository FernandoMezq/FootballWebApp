36548>>>>>>>    //
36548>>>>>>>    //  Converts the given time to an string that can be saved in the database.
36548>>>>>>>    //
36548>>>>>>>    //  Params:
36548>>>>>>>    //      dtTime  Time to convert
36548>>>>>>>    //  Returns:
36548>>>>>>>    //      String with "HH:MM:SS" format
36548>>>>>>>    //
36548>>>>>>>    Function TimeToString DateTime dtTime Returns String
36550>>>>>>>        String sHours sMinutes sSeconds
36550>>>>>>>        
36550>>>>>>>        //  Extract parts
36550>>>>>>>        Move (String(DateGetHour(dtTime))) to sHours
36551>>>>>>>        Move (String(DateGetMinute(dtTime))) to sMinutes
36552>>>>>>>        Move (String(DateGetSecond(dtTime))) to sSeconds
36553>>>>>>>        
36553>>>>>>>        //  Fill out with 0
36553>>>>>>>        If (Length(sHours) = 1) ;            Move ("0" + sHours) to sHours
36556>>>>>>>        If (Length(sMinutes) = 1) ;            Move ("0" + sMinutes) to sMinutes
36559>>>>>>>        If (Length(sSeconds) = 1) ;            Move ("0" + sSeconds) to sSeconds
36562>>>>>>>        
36562>>>>>>>        Function_Return (sHours + ":" + sMinutes + ":" + sSeconds)
36563>>>>>>>    End_Function
36564>>>>>>>    
36564>>>>>>>    //
36564>>>>>>>    //  Sets the time of the datetime variable to the time in the string.
36564>>>>>>>    //
36564>>>>>>>    //  Params:
36564>>>>>>>    //      dtTime  Datetime variable to add time to
36564>>>>>>>    //      sTimeString String with time in the format "HH:MM:SS"
36564>>>>>>>    //  Returns:
36564>>>>>>>    //      dtDateTime with the loaded time
36564>>>>>>>    //
36564>>>>>>>    Function StringToTime DateTime dtTime String sTimeString Returns DateTime
36566>>>>>>>        String sHours sMinutes sSeconds
36566>>>>>>>        
36566>>>>>>>        //  Extract parts
36566>>>>>>>        Move (Mid(sTimeString, 2, 1)) to sHours
36567>>>>>>>        Move (Mid(sTimeString, 2, 4)) to sMinutes
36568>>>>>>>        Move (Mid(sTimeString, 2, 7)) to sSeconds
36569>>>>>>>        
36569>>>>>>>        //  Set to DateTime
36569>>>>>>>        Move (DateSetHour(dtTime, (Integer(sHours)))) to dtTime
36570>>>>>>>        Move (DateSetMinute(dtTime, (Integer(sMinutes)))) to dtTime
36571>>>>>>>        Move (DateSetSecond(dtTime, (Integer(sSeconds)))) to dtTime
36572>>>>>>>        
36572>>>>>>>        Function_Return dtTime
36573>>>>>>>    End_Function
36574>>>>>>>End_Class
