37286>>>        Get StateHash of ghoWebApp to sPrevStateHash
37287>>>        Send ParseViewStateHash sPrevStateHash (&sView)
37288>>>        If (Lowercase(sView) <> Lowercase(psStateViewName(Self))) Begin
37290>>>            WebSet psPrevStateHash to sPrevStateHash
37291>>>        End
37291>>>>
37291>>>        
37291>>>    End_Procedure
