38974>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38974>>>                Case Break
38975>>>
38975>>>            Case Else // must be nfUndefined
38975>>>
38975>>>        Case End
38975>>>
38975>>>        Send SetActionButtons
38976>>>
