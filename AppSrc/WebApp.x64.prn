37252>>>        Send ParseViewStateHash sPrevStateHash (&sView)
37253>>>        If (Lowercase(sView) <> Lowercase(psStateViewName(Self))) Begin
37255>>>            WebSet psPrevStateHash to sPrevStateHash
37256>>>        End
37256>>>>
37256>>>        
37256>>>    End_Procedure
