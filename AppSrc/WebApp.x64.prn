36879>>>>>Class cWebSessionManagerStandard is a cWebSessionManager
36880>>>>>    
36880>>>>>    Procedure Construct_Object
36882>>>>>        Handle hoObj
36882>>>>>        
36882>>>>>        Forward Send Construct_Object
36884>>>>>        
36884>>>>>        Set pbSessionCookieHttpOnly to True
36885>>>>>        
36885>>>>>        Property Handle phoUserDD 0      // Handle to the WebAppUser DDO
36886>>>>>        Property Handle phoSessionDD 0   // Handle to the WebAppSession DDO  
36887>>>>>        Property Handle phoCrypto 0      // Handle to the PasswordHasher
36888>>>>>        
36888>>>>>        Get CreateNamed (RefClass(cWebAppUserDataDictionary)) 'oUserDD' to hoObj
36889>>>>>        Set phoUserDD to hoObj
36890>>>>>        
36890>>>>>        Get CreateNamed (RefClass(cWebAppSessionDataDictionary)) 'oSessionDD' to hoObj
36891>>>>>        Set DDO_Server of hoObj to (phoUserDD(Self))
36892>>>>>        Set phoSessionDD to hoObj
36893>>>>>        
36893>>>>>        Property Handle phoCrypto 0   // Handle to the Cryptographer
36894>>>>>        Get CreateNamed (RefClass(cPasswordHasher)) 'oCrypto' to hoObj
36895>>>>>        Set phoCrypto to hoObj
36896>>>>>        
36896>>>>>        Property Boolean pbPasswordHashing True
36897>>>>>        
36897>>>>>        Property Boolean pbCreatingNewSession False
36898>>>>>        Property String psLoginName
36899>>>>>        Property String psUserName ""
36900>>>>>        Property Integer piUserRights 0
36901>>>>>    End_Procedure
36902>>>>>    
36902>>>>>    Procedure End_Construct_Object
36904>>>>>        Forward Send End_Construct_Object
36906>>>>>        
36906>>>>>        Handle hoCrypto
36906>>>>>        Integer iFieldLen
36906>>>>>        If (pbPasswordHashing(Self)) Begin
36908>>>>>            Get phoCrypto to hoCrypto
36909>>>>>            Get_Attribute DF_FIELD_LENGTH of (RefTable(WebAppUser)) (RefTable(WebAppUser.Password)) to iFieldLen
36912>>>>>            If (iFieldLen < (RequiredBufferSize(hoCrypto) + 3)) Begin
36914>>>>>                Error DFERR_PROGRAM "The password field of WebAppUser is not large enough (128)"
36915>>>>>>
36915>>>>>            End
36915>>>>>>
36915>>>>>        End
36915>>>>>>
36915>>>>>    End_Procedure
36916>>>>>    
36916>>>>>    Function CreateSession String sRemoteAddress Returns String
36918>>>>>        String sSessionKey
36918>>>>>        Integer iErr
36918>>>>>        Boolean bLogWebSession
36918>>>>>        Handle hoSessionDD       
36918>>>>>        Get phoSessionDD to hoSessionDD
36919>>>>>        
36919>>>>>        //  Get session key
36919>>>>>        Forward Get CreateSession sRemoteAddress to sSessionKey
36921>>>>>        
36921>>>>>        Get pbLogWebSession to bLogWebSession
36922>>>>>        If not bLogWebSession Begin
36924>>>>>            Function_Return sSessionKey        
36925>>>>>        End
36925>>>>>>
36925>>>>>
36925>>>>>        //  Store session
36925>>>>>        Send Clear of hoSessionDD
36926>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.SessionKey to sSessionKey
36927>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.RemoteAddress to sRemoteAddress
36928>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.Active to "Y"
36929>>>>>        Get Request_Validate of hoSessionDD to iErr
36930>>>>>        If (iErr) Begin
36932>>>>>            // this should not happen. If it does its a programming error
36932>>>>>            Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
36933>>>>>>
36933>>>>>            Function_Return ""
36934>>>>>        End
36934>>>>>>
36934>>>>>        Send Request_Save of hoSessionDD
36935>>>>>        If (Err) Begin
36937>>>>>            // this shouldn't happen, if it does likely a duplicate session key issue, even through request_save already gave an error we give another one to make tracking down easier
36937>>>>>            Error DFERR_PROGRAM C_$WebAppSessionSaveFailed
36938>>>>>>
36938>>>>>            Function_Return ""
36939>>>>>        End
36939>>>>>>
36939>>>>>       
36939>>>>>        Function_Return sSessionKey        
36940>>>>>    End_Function
36941>>>>>    
36941>>>>>    Function ValidateSession String sSessionKey Boolean bOptLoadWebApp Returns Boolean
36943>>>>>        DateTime dtLastAccess dtCurrent
36943>>>>>        TimeSpan tsDiff
36943>>>>>        Integer iErr iSessionTimeout iSpanMinutes
36943>>>>>        Boolean bResult bCreatingNewSession
36943>>>>>        Boolean bLogWebSession bLoadWebApp
36943>>>>>        Integer eLoginMode
36943>>>>>        String sTime
36943>>>>>        Handle hoSessionDD hoUserDD       
36943>>>>>        
36943>>>>>        Move False to bLoadWebApp
36944>>>>>        If (num_arguments >= 2) Begin
36946>>>>>            Move bOptLoadWebApp to bLoadWebApp
36947>>>>>        End
36947>>>>>>
36947>>>>>        
36947>>>>>        Get phoSessionDD to hoSessionDD
36948>>>>>        Get phoUserDD to hoUserDD
36949>>>>>        
36949>>>>>        Get pbLogWebSession to bLogWebSession
36950>>>>>        Get peLoginMode to eLoginMode
36951>>>>>        
36951>>>>>        // for this object, you can only disable logging if login completely is disabled
36951>>>>>        If (not(bLogWebSession) and (eLoginMode<>lmLoginNone)) Begin
36953>>>>>            Error DFERR_PROGRAM C_$WebSessionLoggingMustBeEnabled
36954>>>>>>
36954>>>>>            Function_Return False
36955>>>>>        End
36955>>>>>>
36955>>>>>
36955>>>>>        //  Clear session properties
36955>>>>>        Set psSessionKey to ""
36956>>>>>        Send UpdateSessionProperties True
36957>>>>>        
36957>>>>>        If not bLogWebSession Begin
36959>>>>>            Forward Get ValidateSession sSessionKey to bResult
36961>>>>>            Function_Return bResult
36962>>>>>        End        
36962>>>>>>
36962>>>>>        
36962>>>>>        Move False to bResult
36963>>>>>        Get piSessionTimeout to iSessionTimeout 
36964>>>>>        
36964>>>>>        //  Check if session exists
36964>>>>>        Send Clear of hoSessionDD
36965>>>>>        Move sSessionKey to WebAppSession.SessionKey
36966>>>>>        Send Find of hoSessionDD EQ Index.1
36967>>>>>            
36967>>>>>        If (Found) Begin
36969>>>>>            //  Calculate timespan between now and last access time
36969>>>>>            Move (CurrentDateTime()) to dtCurrent
36970>>>>>            Move WebAppSession.LastAccessDate to dtLastAccess
36971>>>>>            Get StringToTime of hoSessionDD dtLastAccess WebAppSession.LastAccessTime to dtLastAccess
36972>>>>>            Move (dtCurrent - dtLastAccess) to tsDiff
36973>>>>>            Move (SpanTotalMinutes(tsDiff)) to iSpanMinutes
36974>>>>>            
36974>>>>>            //  Check if session didn't time out
36974>>>>>            If (IsDateValid(dtLastAccess) and (iSessionTimeout <= 0 or (iSpanMinutes < iSessionTimeout)) and WebAppSession.Active = "Y") Begin
36976>>>>>                Forward Get ValidateSession sSessionKey to bResult
36978>>>>>                   
36978>>>>>                If (bResult) Begin
36980>>>>>                    //  Update session record
36980>>>>>                    Get TimeToString of hoSessionDD dtCurrent to sTime 
36981>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessDate to dtCurrent
36982>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessTime to sTime
36983>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.UseCount to (WebAppSession.UseCount + 1)
36984>>>>>                    Get Request_Validate of hoSessionDD to iErr
36985>>>>>                    If (iErr) Begin
36987>>>>>                        // this should not happen. If it does its a programming error
36987>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
36988>>>>>>
36988>>>>>                        Function_Return False
36989>>>>>                    End
36989>>>>>>
36989>>>>>                    Send Request_Save of hoSessionDD
36990>>>>>                    
36990>>>>>                    //  Update user properties
36990>>>>>                    Send UpdateSessionProperties False
36991>>>>>                End
36991>>>>>>
36991>>>>>            End
36991>>>>>>
36991>>>>>            Else Begin
36992>>>>>                // Test the Creating New Session Flag to protect against infinite recursion....
36992>>>>>                Get pbCreatingNewSession to bCreatingNewSession
36993>>>>>                
36993>>>>>                If (not(bCreatingNewSession)) Begin
36995>>>>>                    If (not(bLoadWebApp)) Begin
36997>>>>>                        Move False to bResult   //  We can only continue immediately if we were loading the webapp, other operations are not allowed!
36998>>>>>                        Error DFERR_WEBAPP_SESSION_TIMEOUT "Your application session has timed out or is inactive, please login again."
36999>>>>>>
36999>>>>>                        Send NavigateRefresh of ghoWebApp          // refresh the WebApp at the client (triggers a login)
37000>>>>>                    End
37000>>>>>>
37000>>>>>                    Else Begin
37001>>>>>                        Set pbCreatingNewSession to True                    
37002>>>>>                        Get RecreateSession of ghoWebApp to bResult 
37003>>>>>                        Set pbCreatingNewSession to False                        
37004>>>>>                    End
37004>>>>>>
37004>>>>>                End
37004>>>>>>
37004>>>>>            End
37004>>>>>>
37004>>>>>        End
37004>>>>>>
37004>>>>>        Else Begin
37005>>>>>            Error DFERR_WEBAPP_BAD_SESSION_KEY "Session key not known (reload page to recreate session)"
37006>>>>>>
37006>>>>>        End
37006>>>>>>
37006>>>>>        
37006>>>>>        Function_Return bResult
37007>>>>>    End_Function
37008>>>>>    
37008>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
37010>>>>>        If (not(pbPasswordHashing(Self))) Begin
37012>>>>>            Move sPassword to sHash
37013>>>>>            Function_Return True
37014>>>>>        End
37014>>>>>>
37014>>>>>        
37014>>>>>        If (not(CreatePasswordHash(phoCrypto(Self), sPassword, &sHash))) Begin
37016>>>>>            Function_Return False
37017>>>>>        End
37017>>>>>>
37017>>>>>        Move ("V1$" + sHash) to sHash
37018>>>>>        Function_Return True
37019>>>>>    End_Function
37020>>>>>    
37020>>>>>    Function VerifyPasswordHash String sUserPassword String sEnteredPassword Boolean ByRef bShouldUpgrade Returns Boolean
37022>>>>>        If (not(pbPasswordHashing(Self))) Begin
37024>>>>>            Move False to bShouldUpgrade
37025>>>>>            Function_Return (sUserPassword = sEnteredPassword)
37026>>>>>        End
37026>>>>>>
37026>>>>>        
37026>>>>>        String sVersion
37026>>>>>        Move (Left(sUserPassword, 3)) to sVersion
37027>>>>>        If (sVersion = "V1$") Begin
37029>>>>>            If (num_arguments > 2) Move False to bShouldUpgrade
37032>>>>>            Function_Return (VerifyPasswordHash(phoCrypto(Self), sEnteredPassword, Right(sUserPassword, Length(sUserPassword) - 3)))
37033>>>>>        End
37033>>>>>>
37033>>>>>        Else Begin
37034>>>>>            If (num_arguments > 2) Move True to bShouldUpgrade
37037>>>>>            Function_Return False
37038>>>>>        End
37038>>>>>>
37038>>>>>    End_Function
37039>>>>>    
37039>>>>>    Function UserRegister String sLoginName String sPassword Returns Boolean
37041>>>>>        Handle hoUserDD
37041>>>>>        Integer iErr
37041>>>>>        Get phoUserDD to hoUserDD
37042>>>>>        
37042>>>>>        //  Find the user
37042>>>>>        Send Clear of hoUserDD
37043>>>>>        Move sLoginName to WebAppUser.LoginName
37044>>>>>        Send Find of hoUserDD EQ Index.1
37045>>>>>        If (Found) Begin
37047>>>>>            Send Clear of hoUserDD
37048>>>>>            Function_Return False
37049>>>>>        End
37049>>>>>>
37049>>>>>        
37049>>>>>        Send Clear of hoUserDD
37050>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.FullName to sLoginName
37051>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.LoginName to sLoginName
37052>>>>>        If (not(CreatePasswordHash(Self, Trim(sPassword), &sPassword))) Begin
37054>>>>>            Send Clear of hoUserDD
37055>>>>>            Function_Return False
37056>>>>>        End
37056>>>>>>
37056>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37057>>>>>        Get Request_Validate of hoUserDD to iErr
37058>>>>>        If (iErr) Begin
37060>>>>>            Send Clear of hoUserDD
37061>>>>>            Function_Return False
37062>>>>>        End
37062>>>>>>
37062>>>>>        
37062>>>>>        Send Request_Save of hoUserDD
37063>>>>>        Function_Return (not(Err))
37064>>>>>    End_Function
37065>>>>>    
37065>>>>>    Function UserLogin String sLoginName String sPassword Returns Boolean
37067>>>>>        String sSessionKey sUserPassword
37067>>>>>        Handle hoSessionDD hoUserDD
37067>>>>>        Boolean bMatch bUpgrade
37067>>>>>        
37067>>>>>        Get phoSessionDD to hoSessionDD
37068>>>>>        Get phoUserDD to hoUserDD
37069>>>>>        Integer iErr eLoginMode
37069>>>>>        
37069>>>>>        // Refind session record
37069>>>>>        Get psSessionKey to sSessionKey
37070>>>>>        Send Clear of hoSessionDD
37071>>>>>        Move sSessionKey to WebAppSession.SessionKey
37072>>>>>        Send Find of hoSessionDD EQ Index.1
37073>>>>>        
37073>>>>>        If (Found and WebAppSession.SessionKey = sSessionKey) Begin
37075>>>>>            Get peLoginMode to eLoginMode
37076>>>>>            
37076>>>>>            //  Find the user
37076>>>>>            Move sLoginName to WebAppUser.LoginName
37077>>>>>            Send Find of hoUserDD EQ Index.1
37078>>>>>            
37078>>>>>            // Check username and password
37078>>>>>            If (Found and (Lowercase(sLoginName) = Lowercase(Trim(WebAppUser.LoginName)))) Begin
37080>>>>>                Get Field_Current_Value of hoUserDD Field WebAppUser.Password to sUserPassword
37081>>>>>                Get VerifyPasswordHash (Trim(sUserPassword)) (Trim(sPassword)) (&bUpgrade) to bMatch
37082>>>>>                
37082>>>>>                If (bMatch) Begin
37084>>>>>                    // Store the login
37084>>>>>                    If (bUpgrade) Begin
37086>>>>>                        Get CreatePasswordHash (Trim(sPassword)) (&sPassword) to bUpgrade
37087>>>>>                        If (bUpgrade) Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37090>>>>>                    End
37090>>>>>>
37090>>>>>                    Set Field_Changed_Value of hoUserDD Field WebAppUser.LastLogin to (CurrentDateTime())
37091>>>>>                    Get Request_Validate of hoSessionDD to iErr
37092>>>>>                    If (iErr) Begin
37094>>>>>                        // this should not happen. If it does its a programming error
37094>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37095>>>>>>
37095>>>>>                        Function_Return False
37096>>>>>                    End
37096>>>>>>
37096>>>>>                    
37096>>>>>                    Send Request_Save of hoSessionDD
37097>>>>>                    
37097>>>>>                    // Update session properties
37097>>>>>                    Send UpdateSessionProperties False
37098>>>>>                    Send NotifyChangeRights
37099>>>>>                    Function_Return True
37100>>>>>                End
37100>>>>>>
37100>>>>>                Else Begin
37101>>>>>                    //  We should rely directly on this buffer elsewhere but just be sure
37101>>>>>                    Send Clear of hoUserDD
37102>>>>>                End
37102>>>>>>
37102>>>>>            End
37102>>>>>>
37102>>>>>            Else Begin
37103>>>>>                // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37103>>>>>                Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37104>>>>>            End
37104>>>>>>
37104>>>>>        End
37104>>>>>>
37104>>>>>        Else Begin
37105>>>>>            // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37105>>>>>            Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37106>>>>>        End
37106>>>>>>
37106>>>>>          
37106>>>>>        Function_Return False
37107>>>>>    End_Function
37108>>>>>    
37108>>>>>    Function SetUserPassword String sLoginName String sPassword Returns Boolean
37110>>>>>        Handle hoUserDD
37110>>>>>        Integer iErr
37110>>>>>        Get phoUserDD to hoUserDD
37111>>>>>        
37111>>>>>        //  Find the user
37111>>>>>        Send Clear of hoUserDD
37112>>>>>        Move sLoginName to WebAppUser.LoginName
37113>>>>>        Send Find of hoUserDD EQ Index.1
37114>>>>>        If (not(Found)) Begin
37116>>>>>            Send Clear of hoUserDD
37117>>>>>            Function_Return False
37118>>>>>        End
37118>>>>>>
37118>>>>>        
37118>>>>>        If (not(CreatePasswordHash(Self, Trim(sPassword), &sPassword))) Begin
37120>>>>>            Send Clear of hoUserDD
37121>>>>>            Function_Return False
37122>>>>>        End
37122>>>>>>
37122>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37123>>>>>        Get Request_Validate of hoUserDD to iErr
37124>>>>>        If (iErr) Begin
37126>>>>>            Send Clear of hoUserDD
37127>>>>>            Function_Return False
37128>>>>>        End
37128>>>>>>
37128>>>>>        
37128>>>>>        Send Request_Save of hoUserDD
37129>>>>>        Function_Return (not(Err))
37130>>>>>    End_Function
37131>>>>>    
37131>>>>>    Function IsLoggedIn Returns Boolean
37133>>>>>        String sLoginName
37133>>>>>        Boolean bLogWebSession bLoggedIn
37133>>>>>        
37133>>>>>        Get pbLogWebSession to bLogWebSession
37134>>>>>        If not bLogWebSession Begin
37136>>>>>            Forward Get IsLoggedIn to bLoggedIn
37138>>>>>            Function_Return bLoggedIn
37139>>>>>        End
37139>>>>>>
37139>>>>>        
37139>>>>>        Get psLoginName to sLoginName
37140>>>>>        
37140>>>>>        Function_Return (sLoginName <> "")
37141>>>>>    End_Function
37142>>>>>    
37142>>>>>    
37142>>>>>    //
37142>>>>>    // This procedure is called when validating a session and after logging in. Its purpose is to 
37142>>>>>    // update properties based on the session and user data. Augment this function to update 
37142>>>>>    // properties based on the session / user table. Note that WebAppUser and WebAppSession contain
37142>>>>>    // the right records when this procedure is called.
37142>>>>>    //
37142>>>>>    // Params:
37142>>>>>    //      bClear   True if the procedure is called before session validation to clear properties.
37142>>>>>    //
37142>>>>>    Procedure UpdateSessionProperties Boolean bClear
37144>>>>>        Handle hoUserDD
37144>>>>>        
37144>>>>>        Get phoUserDD to hoUserDD
37145>>>>>        
37145>>>>>        //  Update user properties
37145>>>>>        If (not(bClear) and HasRecord(hoUserDD)) Begin
37147>>>>>            Set psUsername to (Trim(WebAppUser.FullName))
37148>>>>>            Set psLoginName to (Trim(WebAppUser.LoginName))
37149>>>>>            Set piUserRights to WebAppUser.Rights
37150>>>>>            
37150>>>>>            Send OnSessionPropertiesSet 
37151>>>>>        End
37151>>>>>>
37151>>>>>        Else Begin
37152>>>>>            Set psUsername to ""
37153>>>>>            Set psLoginName to ""
37154>>>>>            Set piUserRights to 0
37155>>>>>            
37155>>>>>            Send OnSessionPropertiesClear
37156>>>>>        End
37156>>>>>>
37156>>>>>    End_Procedure
37157>>>>>    
37157>>>>>    Procedure OnSessionPropertiesSet
37159>>>>>        //  Empty event stub
37159>>>>>    End_Procedure
37160>>>>>    
37160>>>>>    Procedure OnSessionPropertiesClear
37162>>>>>        //  Empty event stub
37162>>>>>    End_Procedure
37163>>>>>    
37163>>>>>    Procedure EndSession
37165>>>>>        Integer iErr
37165>>>>>        Boolean bLogWebSession
37165>>>>>        Handle hoSessionDD       
37165>>>>>        
37165>>>>>        Get phoSessionDD to hoSessionDD
37166>>>>>        Get pbLogWebSession to bLogWebSession
37167>>>>>        If not bLogWebSession Begin
37169>>>>>            Forward Send EndSession
37171>>>>>            Procedure_Return
37172>>>>>        End
37172>>>>>>
37172>>>>>            
37172>>>>>        //  Check if session exists
37172>>>>>        Send Clear of hoSessionDD
37173>>>>>        Get psSessionKey to WebAppSession.SessionKey
37174>>>>>        
37174>>>>>        Send Find of hoSessionDD EQ Index.1
37175>>>>>        If (Found) Begin
37177>>>>>            Set Field_Changed_Value of hoSessionDD Field WebAppSession.Active to "N"
37178>>>>>            Get Request_Validate of hoSessionDD to iErr
37179>>>>>            If (iErr) Begin
37181>>>>>                // this should not happen. If it does its a programming error
37181>>>>>                Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37182>>>>>>
37182>>>>>                Procedure_Return
37183>>>>>            End
37183>>>>>>
37183>>>>>            Send Request_Save of hoSessionDD
37184>>>>>        End
37184>>>>>>
37184>>>>>    End_Procedure
37185>>>>>
37185>>>>>End_Class
