37620>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
37623>>>        // Close after save
37623>>>        Send NavigateClose Self
37624>>>    End_Procedure
37625>>>
37625>>>    // this will close the view after a delete
37625>>>    Procedure OnViewDeleted Handle hoDDO
37628>>>        Send NavigateClose Self
