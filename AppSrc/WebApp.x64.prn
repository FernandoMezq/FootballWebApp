38098>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38098>>>                Case Break
38099>>>
38099>>>            Case Else // must be nfUndefined
38099>>>
38099>>>        Case End
38099>>>
38099>>>        Send SetActionButtons
