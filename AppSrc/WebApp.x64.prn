38952>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38955>>>        Case Begin
38955>>>            Case (NavigateData.eNavigateType = nfFromMain)
38957>>>                // If from main, this is a propbably a main file Select to Zoom.
38957>>>                Case Break
38958>>>
38958>>>            Case (NavigateData.eNavigateType = nfFromParent)
38961>>>                // If from parent, this is a constrained drill down.
38961>>>                Case Break
38962>>>
38962>>>            Case (NavigateData.eNavigateType = nfFromChild)
38965>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38965>>>                Case Break
38966>>>
38966>>>            Case Else // must be nfUndefined
38966>>>
38966>>>        Case End
38966>>>
38966>>>        Send SetActionButtons
38967>>>
38967>>>    End_Procedure
38968>>>
38968>>>End_Object 
