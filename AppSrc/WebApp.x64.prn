38876>>>    Procedure SetActionButtons
38879>>>        tWebNavigateData NavigateData
38879>>>        tWebNavigateData NavigateData
38879>>>        Boolean bHasRecord
38879>>>        Handle hoDD
38879>>>
38879>>>        Get Server to hoDD
38880>>>        Get GetNavigateData to NavigateData
38881>>>        Get HasRecord of hoDD to bHasRecord
38882>>>
38882>>>        // let's hide all buttons and then Show the ones we want
38882>>>        WebSet pbRender of oEditBtn to False
38883>>>        WebSet pbRender of oSaveBtn to False
38884>>>        WebSet pbRender of oCancelChangesBtn to False
38885>>>        WebSet pbRender of oDeleteBtn to False
38886>>>
38886>>>        If (NavigateData.bReadOnly) Begin
38888>>>            WebSet pbRender of oEditBtn to True
38889>>>        End
38889>>>>
38889>>>        Else Begin
38890>>>            WebSet pbRender of oSaveBtn to True
38891>>>            WebSet pbRender of oCancelChangesBtn to True
38892>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38893>>>        End
38893>>>>
38893>>>    End_Procedure
