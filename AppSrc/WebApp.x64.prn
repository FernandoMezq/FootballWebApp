38939>>>    Procedure SetActionButtons
38942>>>        tWebNavigateData NavigateData
38942>>>        tWebNavigateData NavigateData
38942>>>        Boolean bHasRecord
38942>>>        Handle hoDD
38942>>>
38942>>>        Get Server to hoDD
38943>>>        Get GetNavigateData to NavigateData
38944>>>        Get HasRecord of hoDD to bHasRecord
38945>>>
38945>>>        // let's hide all buttons and then Show the ones we want
38945>>>        WebSet pbRender of oEditBtn to False
38946>>>        WebSet pbRender of oSaveBtn to False
38947>>>        WebSet pbRender of oCancelChangesBtn to False
38948>>>        WebSet pbRender of oDeleteBtn to False
38949>>>
38949>>>        If (NavigateData.bReadOnly) Begin
38951>>>            WebSet pbRender of oEditBtn to True
38952>>>        End
38952>>>>
38952>>>        Else Begin
38953>>>            WebSet pbRender of oSaveBtn to True
38954>>>            WebSet pbRender of oCancelChangesBtn to True
38955>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38956>>>        End
38956>>>>
38956>>>    End_Procedure
