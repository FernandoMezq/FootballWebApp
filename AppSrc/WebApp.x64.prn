38971>>>    Procedure SetActionButtons
38974>>>        tWebNavigateData NavigateData
38974>>>        tWebNavigateData NavigateData
38974>>>        Boolean bHasRecord
38974>>>        Handle hoDD
38974>>>
38974>>>        Get Server to hoDD
38975>>>        Get GetNavigateData to NavigateData
38976>>>        Get HasRecord of hoDD to bHasRecord
38977>>>
38977>>>        // let's hide all buttons and then Show the ones we want
38977>>>        WebSet pbRender of oEditBtn to False
38978>>>        WebSet pbRender of oSaveBtn to False
38979>>>        WebSet pbRender of oCancelChangesBtn to False
38980>>>        WebSet pbRender of oDeleteBtn to False
38981>>>
38981>>>        If (NavigateData.bReadOnly) Begin
38983>>>            WebSet pbRender of oEditBtn to True
38984>>>        End
38984>>>>
38984>>>        Else Begin
38985>>>            WebSet pbRender of oSaveBtn to True
38986>>>            WebSet pbRender of oCancelChangesBtn to True
38987>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38988>>>        End
38988>>>>
38988>>>    End_Procedure
