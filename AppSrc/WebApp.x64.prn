38917>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38917>>>                Case Break
38918>>>
38918>>>            Case Else // must be nfUndefined
38918>>>
38918>>>        Case End
38918>>>
38918>>>        Send SetActionButtons
38919>>>
38919>>>    End_Procedure
