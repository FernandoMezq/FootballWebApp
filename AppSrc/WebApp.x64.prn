37222>>>    Procedure DoLogin
37225>>>        String sLoginName sPassword sPrevStateHash
37225>>>        Boolean bResult
37225>>>        
37225>>>        WebGet psValue of oLoginName to sLoginName
37226>>>        WebGet psValue of oPassword to sPassword
37227>>>        
37227>>>        Get UserLogin of ghoWebSessionManager sLoginName sPassword to bResult
37228>>>        
37228>>>        If (bResult) Begin
37230>>>            Send Hide of oLogin
37231>>>            Send ShowHeader of ghoWebApp
37232>>>            WebSet psCSSClass of ghoWebApp to ""
37233>>>            
37233>>>            WebGet psPrevStateHash to sPrevStateHash
37234>>>            Send NavigateToStateHash of ghoWebApp sPrevStateHash True
37235>>>            
37235>>>            
37235>>>            WebSet psValue of oLoginName to ""
37236>>>            WebSet psValue of oPassword  to ""
37237>>>            WebSet pbVisible of oWarning to False
37238>>>        End
37238>>>>
37238>>>        Else Begin
37239>>>            WebSet pbVisible of oWarning to True
37240>>>        End
37240>>>>
37240>>>    End_Procedure
