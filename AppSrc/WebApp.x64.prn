37586>>>    Procedure SetActionButtons
37589>>>        tWebNavigateData NavigateData
37589>>>        tWebNavigateData NavigateData
37589>>>        Boolean bHasRecord
37589>>>        Handle hoDD
37589>>>
37589>>>        Get Server to hoDD
37590>>>        Get GetNavigateData to NavigateData
37591>>>        Get HasRecord of hoDD to bHasRecord
37592>>>
37592>>>        // let's hide all buttons and then Show the ones we want
37592>>>        WebSet pbRender of oEditBtn to False
37593>>>        WebSet pbRender of oSaveBtn to False
37594>>>        WebSet pbRender of oCancelChangesBtn to False
37595>>>        WebSet pbRender of oDeleteBtn to False
37596>>>
37596>>>        If (NavigateData.bReadOnly) Begin
37598>>>            WebSet pbRender of oEditBtn to True
37599>>>        End
37599>>>>
37599>>>        Else Begin
37600>>>            WebSet pbRender of oSaveBtn to True
37601>>>            WebSet pbRender of oCancelChangesBtn to True
37602>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37603>>>        End
37603>>>>
37603>>>    End_Procedure
37604>>>
37604>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
37607>>>        // Close after save
37607>>>        Send NavigateClose Self
37608>>>    End_Procedure
37609>>>
37609>>>    // this will close the view after a delete
37609>>>    Procedure OnViewDeleted Handle hoDDO
37612>>>        Send NavigateClose Self
37613>>>    End_Procedure
37614>>>
37614>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37617>>>        Case Begin
37617>>>            Case (NavigateData.eNavigateType = nfFromMain)
37619>>>                // If from main, this is a propbably a main file Select to Zoom.
37619>>>                Case Break
37620>>>
37620>>>            Case (NavigateData.eNavigateType = nfFromParent)
37623>>>                // If from parent, this is a constrained drill down.
37623>>>                Case Break
37624>>>
37624>>>            Case (NavigateData.eNavigateType = nfFromChild)
37627>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37627>>>                Case Break
37628>>>
37628>>>            Case Else // must be nfUndefined
37628>>>
37628>>>        Case End
37628>>>
37628>>>        Send SetActionButtons
37629>>>
37629>>>    End_Procedure
37630>>>
37630>>>End_Object 
