37904>>>    Procedure SetActionButtons
37907>>>        tWebNavigateData NavigateData
37907>>>        tWebNavigateData NavigateData
37907>>>        Boolean bHasRecord
37907>>>        Handle hoDD
37907>>>
37907>>>        Get Server to hoDD
37908>>>        Get GetNavigateData to NavigateData
37909>>>        Get HasRecord of hoDD to bHasRecord
37910>>>
37910>>>        // let's hide all buttons and then Show the ones we want
37910>>>        WebSet pbRender of oEditBtn to False
37911>>>        WebSet pbRender of oSaveBtn to False
37912>>>        WebSet pbRender of oCancelChangesBtn to False
37913>>>        WebSet pbRender of oDeleteBtn to False
37914>>>
37914>>>        If (NavigateData.bReadOnly) Begin
37916>>>            WebSet pbRender of oEditBtn to True
37917>>>        End
37917>>>>
37917>>>        Else Begin
37918>>>            WebSet pbRender of oSaveBtn to True
37919>>>            WebSet pbRender of oCancelChangesBtn to True
37920>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37921>>>        End
37921>>>>
37921>>>    End_Procedure
