39345>>>
39345>>>        // let's hide all buttons and then Show the ones we want
39345>>>        WebSet pbRender of oEditBtn to False
39346>>>        WebSet pbRender of oSaveBtn to False
39347>>>        WebSet pbRender of oCancelChangesBtn to False
39348>>>        WebSet pbRender of oDeleteBtn to False
39349>>>        WebSet pbRender of oDespedirBtn to False
39350>>>        If (NavigateData.bReadOnly) Begin
39352>>>            WebSet pbRender of oEditBtn to True
39353>>>        End
39353>>>>
39353>>>        Else Begin
39354>>>            WebSet pbRender of oSaveBtn to True
39355>>>            WebSet pbRender of oCancelChangesBtn to True
39356>>>            WebSet pbRender of oDeleteBtn to bHasRecord
39357>>>            WebSet pbRender of oDespedirBtn to bHasRecord
39358>>>
39358>>>        End
