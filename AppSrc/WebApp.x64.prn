37302>>>        
37302>>>       
37302>>>        Get StateHash of ghoWebApp to sPrevStateHash
37303>>>        Send ParseViewStateHash sPrevStateHash (&sView)
37304>>>        If (Lowercase(sView) <> Lowercase(psStateViewName(Self))) Begin
37306>>>            WebSet psPrevStateHash to sPrevStateHash
37307>>>        End
37307>>>>
37307>>>        
37307>>>    End_Procedure
