36549>>>>>>>    //
36549>>>>>>>    //  Converts the given time to an string that can be saved in the database.
36549>>>>>>>    //
36549>>>>>>>    //  Params:
36549>>>>>>>    //      dtTime  Time to convert
36549>>>>>>>    //  Returns:
36549>>>>>>>    //      String with "HH:MM:SS" format
36549>>>>>>>    //
36549>>>>>>>    Function TimeToString DateTime dtTime Returns String
36551>>>>>>>        String sHours sMinutes sSeconds
36551>>>>>>>        
36551>>>>>>>        //  Extract parts
36551>>>>>>>        Move (String(DateGetHour(dtTime))) to sHours
36552>>>>>>>        Move (String(DateGetMinute(dtTime))) to sMinutes
36553>>>>>>>        Move (String(DateGetSecond(dtTime))) to sSeconds
36554>>>>>>>        
36554>>>>>>>        //  Fill out with 0
36554>>>>>>>        If (Length(sHours) = 1) ;            Move ("0" + sHours) to sHours
36557>>>>>>>        If (Length(sMinutes) = 1) ;            Move ("0" + sMinutes) to sMinutes
36560>>>>>>>        If (Length(sSeconds) = 1) ;            Move ("0" + sSeconds) to sSeconds
36563>>>>>>>        
36563>>>>>>>        Function_Return (sHours + ":" + sMinutes + ":" + sSeconds)
36564>>>>>>>    End_Function
36565>>>>>>>    
36565>>>>>>>    //
36565>>>>>>>    //  Sets the time of the datetime variable to the time in the string.
36565>>>>>>>    //
36565>>>>>>>    //  Params:
