36516>>>>>>>        Move (String(DateGetHour(dtTime))) to sHours
36517>>>>>>>        Move (String(DateGetMinute(dtTime))) to sMinutes
36518>>>>>>>        Move (String(DateGetSecond(dtTime))) to sSeconds
36519>>>>>>>        
36519>>>>>>>        //  Fill out with 0
36519>>>>>>>        If (Length(sHours) = 1) ;            Move ("0" + sHours) to sHours
36522>>>>>>>        If (Length(sMinutes) = 1) ;            Move ("0" + sMinutes) to sMinutes
36525>>>>>>>        If (Length(sSeconds) = 1) ;            Move ("0" + sSeconds) to sSeconds
36528>>>>>>>        
