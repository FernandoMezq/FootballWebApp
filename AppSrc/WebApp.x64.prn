38972>>>                Case Break
38973>>>
38973>>>            Case (NavigateData.eNavigateType = nfFromParent)
38976>>>                // If from parent, this is a constrained drill down.
38976>>>                Case Break
38977>>>
38977>>>            Case (NavigateData.eNavigateType = nfFromChild)
38980>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38980>>>                Case Break
38981>>>
38981>>>            Case Else // must be nfUndefined
38981>>>
38981>>>        Case End
38981>>>
38981>>>        Send SetActionButtons
38982>>>
38982>>>    End_Procedure
