39012>>>                // If from child, this is a probably a parent Zoom from a Zoom.
39012>>>                Case Break
39013>>>
39013>>>            Case Else // must be nfUndefined
39013>>>
39013>>>        Case End
39013>>>
39013>>>        Send SetActionButtons
