37273>>>    Procedure DoLogin
37276>>>        String sLoginName sPassword sPrevStateHash
37276>>>        Boolean bResult
37276>>>        
37276>>>        WebGet psValue of oLoginName to sLoginName
37277>>>        WebGet psValue of oPassword to sPassword
37278>>>        
37278>>>        Get UserLogin of ghoWebSessionManager sLoginName sPassword to bResult
37279>>>        
37279>>>        If (bResult) Begin
37281>>>            Send Hide of oLogin
37282>>>            Send ShowHeader of ghoWebApp
37283>>>            WebSet psCSSClass of ghoWebApp to ""
37284>>>            
37284>>>            WebGet psPrevStateHash to sPrevStateHash
37285>>>            Send NavigateToStateHash of ghoWebApp sPrevStateHash True
37286>>>            
37286>>>            
37286>>>            WebSet psValue of oLoginName to ""
37287>>>            WebSet psValue of oPassword  to ""
37288>>>            WebSet pbVisible of oWarning to False
37289>>>        End
37289>>>>
37289>>>        Else Begin
37290>>>            WebSet pbVisible of oWarning to True
37291>>>        End
37291>>>>
37291>>>    End_Procedure
