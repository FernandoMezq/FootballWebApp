37552>>>    Procedure SetActionButtons
37555>>>        tWebNavigateData NavigateData
37555>>>        tWebNavigateData NavigateData
37555>>>        Boolean bHasRecord
37555>>>        Handle hoDD
37555>>>
37555>>>        Get Server to hoDD
37556>>>        Get GetNavigateData to NavigateData
37557>>>        Get HasRecord of hoDD to bHasRecord
37558>>>
37558>>>        // let's hide all buttons and then Show the ones we want
37558>>>        WebSet pbRender of oEditBtn to False
37559>>>        WebSet pbRender of oSaveBtn to False
37560>>>        WebSet pbRender of oCancelChangesBtn to False
37561>>>        WebSet pbRender of oDeleteBtn to False
37562>>>
37562>>>        If (NavigateData.bReadOnly) Begin
37564>>>            WebSet pbRender of oEditBtn to True
37565>>>        End
37565>>>>
37565>>>        Else Begin
37566>>>            WebSet pbRender of oSaveBtn to True
37567>>>            WebSet pbRender of oCancelChangesBtn to True
37568>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37569>>>        End
37569>>>>
37569>>>    End_Procedure
