37979>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37979>>>                Case Break
37980>>>
37980>>>            Case Else // must be nfUndefined
37980>>>
37980>>>        Case End
37980>>>
37980>>>        Send SetActionButtons
