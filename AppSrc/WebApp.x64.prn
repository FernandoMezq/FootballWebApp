37938>>>    Procedure SetActionButtons
37941>>>        tWebNavigateData NavigateData
37941>>>        tWebNavigateData NavigateData
37941>>>        Boolean bHasRecord
37941>>>        Handle hoDD
37941>>>
37941>>>        Get Server to hoDD
37942>>>        Get GetNavigateData to NavigateData
37943>>>        Get HasRecord of hoDD to bHasRecord
37944>>>
37944>>>        // let's hide all buttons and then Show the ones we want
37944>>>        WebSet pbRender of oEditBtn to False
37945>>>        WebSet pbRender of oSaveBtn to False
37946>>>        WebSet pbRender of oCancelChangesBtn to False
37947>>>        WebSet pbRender of oDeleteBtn to False
37948>>>
37948>>>        If (NavigateData.bReadOnly) Begin
37950>>>            WebSet pbRender of oEditBtn to True
37951>>>        End
37951>>>>
37951>>>        Else Begin
37952>>>            WebSet pbRender of oSaveBtn to True
37953>>>            WebSet pbRender of oCancelChangesBtn to True
37954>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37955>>>        End
37955>>>>
37955>>>    End_Procedure
