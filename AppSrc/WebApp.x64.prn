36988>>>>>    Function UserRegister String sLoginName String sPassword Returns Boolean
36990>>>>>        Handle hoUserDD
36990>>>>>        Integer iErr
36990>>>>>        Get phoUserDD to hoUserDD
36991>>>>>        
36991>>>>>        //  Find the user
36991>>>>>        Send Clear of hoUserDD
36992>>>>>        Move sLoginName to WebAppUser.LoginName
36993>>>>>        Send Find of hoUserDD EQ Index.1
36994>>>>>        If (Found) Begin
36996>>>>>            Send Clear of hoUserDD
36997>>>>>            Function_Return False
36998>>>>>        End
36998>>>>>>
36998>>>>>        
36998>>>>>        Send Clear of hoUserDD
36999>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.FullName to sLoginName
37000>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.LoginName to sLoginName
37001>>>>>        If (not(CreatePasswordHash(Self, Trim(sPassword), &sPassword))) Begin
37003>>>>>            Send Clear of hoUserDD
37004>>>>>            Function_Return False
37005>>>>>        End
37005>>>>>>
37005>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37006>>>>>        Get Request_Validate of hoUserDD to iErr
37007>>>>>        If (iErr) Begin
37009>>>>>            Send Clear of hoUserDD
37010>>>>>            Function_Return False
37011>>>>>        End
37011>>>>>>
37011>>>>>        
37011>>>>>        Send Request_Save of hoUserDD
37012>>>>>        Function_Return (not(Err))
37013>>>>>    End_Function
37014>>>>>    
37014>>>>>    Function UserLogin String sLoginName String sPassword Returns Boolean
37016>>>>>        String sSessionKey sUserPassword
37016>>>>>        Handle hoSessionDD hoUserDD
37016>>>>>        Boolean bMatch bUpgrade
37016>>>>>        
37016>>>>>        Get phoSessionDD to hoSessionDD
37017>>>>>        Get phoUserDD to hoUserDD
37018>>>>>        Integer iErr eLoginMode
37018>>>>>        
37018>>>>>        // Refind session record
37018>>>>>        Get psSessionKey to sSessionKey
37019>>>>>        Send Clear of hoSessionDD
37020>>>>>        Move sSessionKey to WebAppSession.SessionKey
37021>>>>>        Send Find of hoSessionDD EQ Index.1
37022>>>>>        
37022>>>>>        If (Found and WebAppSession.SessionKey = sSessionKey) Begin
37024>>>>>            Get peLoginMode to eLoginMode
37025>>>>>            
37025>>>>>            //  Find the user
37025>>>>>            Move sLoginName to WebAppUser.LoginName
37026>>>>>            Send Find of hoUserDD EQ Index.1
37027>>>>>            
37027>>>>>            // Check username and password
37027>>>>>            If (Found and (Lowercase(sLoginName) = Lowercase(Trim(WebAppUser.LoginName)))) Begin
37029>>>>>                Get Field_Current_Value of hoUserDD Field WebAppUser.Password to sUserPassword
37030>>>>>                Get VerifyPasswordHash (Trim(sUserPassword)) (Trim(sPassword)) (&bUpgrade) to bMatch
37031>>>>>                
37031>>>>>                If (bMatch) Begin
37033>>>>>                    // Store the login
37033>>>>>                    If (bUpgrade) Begin
37035>>>>>                        Get CreatePasswordHash (Trim(sPassword)) (&sPassword) to bUpgrade
37036>>>>>                        If (bUpgrade) Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37039>>>>>                    End
37039>>>>>>
37039>>>>>                    Set Field_Changed_Value of hoUserDD Field WebAppUser.LastLogin to (CurrentDateTime())
37040>>>>>                    Get Request_Validate of hoSessionDD to iErr
37041>>>>>                    If (iErr) Begin
37043>>>>>                        // this should not happen. If it does its a programming error
37043>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37044>>>>>>
37044>>>>>                        Function_Return False
37045>>>>>                    End
37045>>>>>>
37045>>>>>                    
37045>>>>>                    Send Request_Save of hoSessionDD
37046>>>>>                    
37046>>>>>                    // Update session properties
37046>>>>>                    Send UpdateSessionProperties False
37047>>>>>                    Send NotifyChangeRights
37048>>>>>                    Function_Return True
37049>>>>>                End
37049>>>>>>
37049>>>>>                Else Begin
37050>>>>>                    //  We should rely directly on this buffer elsewhere but just be sure
37050>>>>>                    Send Clear of hoUserDD
37051>>>>>                End
37051>>>>>>
37051>>>>>            End
37051>>>>>>
37051>>>>>            Else Begin
37052>>>>>                // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37052>>>>>                Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37053>>>>>            End
37053>>>>>>
37053>>>>>        End
37053>>>>>>
37053>>>>>        Else Begin
37054>>>>>            // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37054>>>>>            Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37055>>>>>        End
37055>>>>>>
37055>>>>>          
37055>>>>>        Function_Return False
37056>>>>>    End_Function
