38262>>>>>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38265>>>>>>>        Case Begin
38265>>>>>>>            Case (NavigateData.eNavigateType = nfFromMain)
38267>>>>>>>                // If from main, this is a propbably a main file Select to Zoom.
38267>>>>>>>                Case Break
38268>>>>>>>
38268>>>>>>>            Case (NavigateData.eNavigateType = nfFromParent)
38271>>>>>>>                // If from parent, this is a constrained drill down.
38271>>>>>>>                Case Break
38272>>>>>>>
38272>>>>>>>            Case (NavigateData.eNavigateType = nfFromChild)
38275>>>>>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38275>>>>>>>                Case Break
38276>>>>>>>
38276>>>>>>>            Case Else // must be nfUndefined
38276>>>>>>>
38276>>>>>>>        Case End
38276>>>>>>>
38276>>>>>>>        Send SetActionButtons
38277>>>>>>>
38277>>>>>>>    End_Procedure
