36828>>>>>Class cWebSessionManagerStandard is a cWebSessionManager
36829>>>>>    
36829>>>>>    Procedure Construct_Object
36831>>>>>        Handle hoObj
36831>>>>>        
36831>>>>>        Forward Send Construct_Object
36833>>>>>        
36833>>>>>        Set pbSessionCookieHttpOnly to True
36834>>>>>        
36834>>>>>        Property Handle phoUserDD 0      // Handle to the WebAppUser DDO
36835>>>>>        Property Handle phoSessionDD 0   // Handle to the WebAppSession DDO  
36836>>>>>        Property Handle phoCrypto 0      // Handle to the PasswordHasher
36837>>>>>        
36837>>>>>        Get CreateNamed (RefClass(cWebAppUserDataDictionary)) 'oUserDD' to hoObj
36838>>>>>        Set phoUserDD to hoObj
36839>>>>>        
36839>>>>>        Get CreateNamed (RefClass(cWebAppSessionDataDictionary)) 'oSessionDD' to hoObj
36840>>>>>        Set DDO_Server of hoObj to (phoUserDD(Self))
36841>>>>>        Set phoSessionDD to hoObj
36842>>>>>        
36842>>>>>        Property Handle phoCrypto 0   // Handle to the Cryptographer
36843>>>>>        Get CreateNamed (RefClass(cPasswordHasher)) 'oCrypto' to hoObj
36844>>>>>        Set phoCrypto to hoObj
36845>>>>>        
36845>>>>>        Property Boolean pbPasswordHashing True
36846>>>>>        
36846>>>>>        Property Boolean pbCreatingNewSession False
36847>>>>>        Property String psLoginName
36848>>>>>        Property String psUserName ""
36849>>>>>        Property Integer piUserRights 0
36850>>>>>    End_Procedure
36851>>>>>    
36851>>>>>    Procedure End_Construct_Object
36853>>>>>        Forward Send End_Construct_Object
36855>>>>>        
36855>>>>>        Handle hoCrypto
36855>>>>>        Integer iFieldLen
36855>>>>>        If (pbPasswordHashing(Self)) Begin
36857>>>>>            Get phoCrypto to hoCrypto
36858>>>>>            Get_Attribute DF_FIELD_LENGTH of (RefTable(WebAppUser)) (RefTable(WebAppUser.Password)) to iFieldLen
36861>>>>>            If (iFieldLen < (RequiredBufferSize(hoCrypto) + 3)) Begin
36863>>>>>                Error DFERR_PROGRAM "The password field of WebAppUser is not large enough (128)"
36864>>>>>>
36864>>>>>            End
36864>>>>>>
36864>>>>>        End
36864>>>>>>
36864>>>>>    End_Procedure
36865>>>>>    
36865>>>>>    Function CreateSession String sRemoteAddress Returns String
36867>>>>>        String sSessionKey
36867>>>>>        Integer iErr
36867>>>>>        Boolean bLogWebSession
36867>>>>>        Handle hoSessionDD       
36867>>>>>        Get phoSessionDD to hoSessionDD
36868>>>>>        
36868>>>>>        //  Get session key
36868>>>>>        Forward Get CreateSession sRemoteAddress to sSessionKey
36870>>>>>        
36870>>>>>        Get pbLogWebSession to bLogWebSession
36871>>>>>        If not bLogWebSession Begin
36873>>>>>            Function_Return sSessionKey        
36874>>>>>        End
36874>>>>>>
36874>>>>>
36874>>>>>        //  Store session
36874>>>>>        Send Clear of hoSessionDD
36875>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.SessionKey to sSessionKey
36876>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.RemoteAddress to sRemoteAddress
36877>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.Active to "Y"
36878>>>>>        Get Request_Validate of hoSessionDD to iErr
36879>>>>>        If (iErr) Begin
36881>>>>>            // this should not happen. If it does its a programming error
36881>>>>>            Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
36882>>>>>>
36882>>>>>            Function_Return ""
36883>>>>>        End
36883>>>>>>
36883>>>>>        Send Request_Save of hoSessionDD
36884>>>>>        If (Err) Begin
36886>>>>>            // this shouldn't happen, if it does likely a duplicate session key issue, even through request_save already gave an error we give another one to make tracking down easier
36886>>>>>            Error DFERR_PROGRAM C_$WebAppSessionSaveFailed
36887>>>>>>
36887>>>>>            Function_Return ""
36888>>>>>        End
36888>>>>>>
36888>>>>>       
36888>>>>>        Function_Return sSessionKey        
36889>>>>>    End_Function
36890>>>>>    
36890>>>>>    Function ValidateSession String sSessionKey Boolean bOptLoadWebApp Returns Boolean
36892>>>>>        DateTime dtLastAccess dtCurrent
36892>>>>>        TimeSpan tsDiff
36892>>>>>        Integer iErr iSessionTimeout iSpanMinutes
36892>>>>>        Boolean bResult bCreatingNewSession
36892>>>>>        Boolean bLogWebSession bLoadWebApp
36892>>>>>        Integer eLoginMode
36892>>>>>        String sTime
36892>>>>>        Handle hoSessionDD hoUserDD       
36892>>>>>        
36892>>>>>        Move False to bLoadWebApp
36893>>>>>        If (num_arguments >= 2) Begin
36895>>>>>            Move bOptLoadWebApp to bLoadWebApp
36896>>>>>        End
36896>>>>>>
36896>>>>>        
36896>>>>>        Get phoSessionDD to hoSessionDD
36897>>>>>        Get phoUserDD to hoUserDD
36898>>>>>        
36898>>>>>        Get pbLogWebSession to bLogWebSession
36899>>>>>        Get peLoginMode to eLoginMode
36900>>>>>        
36900>>>>>        // for this object, you can only disable logging if login completely is disabled
36900>>>>>        If (not(bLogWebSession) and (eLoginMode<>lmLoginNone)) Begin
36902>>>>>            Error DFERR_PROGRAM C_$WebSessionLoggingMustBeEnabled
36903>>>>>>
36903>>>>>            Function_Return False
36904>>>>>        End
36904>>>>>>
36904>>>>>
36904>>>>>        //  Clear session properties
36904>>>>>        Set psSessionKey to ""
36905>>>>>        Send UpdateSessionProperties True
36906>>>>>        
36906>>>>>        If not bLogWebSession Begin
36908>>>>>            Forward Get ValidateSession sSessionKey to bResult
36910>>>>>            Function_Return bResult
36911>>>>>        End        
36911>>>>>>
36911>>>>>        
36911>>>>>        Move False to bResult
36912>>>>>        Get piSessionTimeout to iSessionTimeout 
36913>>>>>        
36913>>>>>        //  Check if session exists
36913>>>>>        Send Clear of hoSessionDD
36914>>>>>        Move sSessionKey to WebAppSession.SessionKey
36915>>>>>        Send Find of hoSessionDD EQ Index.1
36916>>>>>            
36916>>>>>        If (Found) Begin
36918>>>>>            //  Calculate timespan between now and last access time
36918>>>>>            Move (CurrentDateTime()) to dtCurrent
36919>>>>>            Move WebAppSession.LastAccessDate to dtLastAccess
36920>>>>>            Get StringToTime of hoSessionDD dtLastAccess WebAppSession.LastAccessTime to dtLastAccess
36921>>>>>            Move (dtCurrent - dtLastAccess) to tsDiff
36922>>>>>            Move (SpanTotalMinutes(tsDiff)) to iSpanMinutes
36923>>>>>            
36923>>>>>            //  Check if session didn't time out
36923>>>>>            If (IsDateValid(dtLastAccess) and (iSessionTimeout <= 0 or (iSpanMinutes < iSessionTimeout)) and WebAppSession.Active = "Y") Begin
36925>>>>>                Forward Get ValidateSession sSessionKey to bResult
36927>>>>>                   
36927>>>>>                If (bResult) Begin
36929>>>>>                    //  Update session record
36929>>>>>                    Get TimeToString of hoSessionDD dtCurrent to sTime 
36930>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessDate to dtCurrent
36931>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessTime to sTime
36932>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.UseCount to (WebAppSession.UseCount + 1)
36933>>>>>                    Get Request_Validate of hoSessionDD to iErr
36934>>>>>                    If (iErr) Begin
36936>>>>>                        // this should not happen. If it does its a programming error
36936>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
36937>>>>>>
36937>>>>>                        Function_Return False
36938>>>>>                    End
36938>>>>>>
36938>>>>>                    Send Request_Save of hoSessionDD
36939>>>>>                    
36939>>>>>                    //  Update user properties
36939>>>>>                    Send UpdateSessionProperties False
36940>>>>>                End
36940>>>>>>
36940>>>>>            End
36940>>>>>>
36940>>>>>            Else Begin
36941>>>>>                // Test the Creating New Session Flag to protect against infinite recursion....
36941>>>>>                Get pbCreatingNewSession to bCreatingNewSession
36942>>>>>                
36942>>>>>                If (not(bCreatingNewSession)) Begin
36944>>>>>                    If (not(bLoadWebApp)) Begin
36946>>>>>                        Move False to bResult   //  We can only continue immediately if we were loading the webapp, other operations are not allowed!
36947>>>>>                        Error DFERR_WEBAPP_SESSION_TIMEOUT "Your application session has timed out or is inactive, please login again."
36948>>>>>>
36948>>>>>                        Send NavigateRefresh of ghoWebApp          // refresh the WebApp at the client (triggers a login)
36949>>>>>                    End
36949>>>>>>
36949>>>>>                    Else Begin
36950>>>>>                        Set pbCreatingNewSession to True                    
36951>>>>>                        Get RecreateSession of ghoWebApp to bResult 
36952>>>>>                        Set pbCreatingNewSession to False                        
36953>>>>>                    End
36953>>>>>>
36953>>>>>                End
36953>>>>>>
36953>>>>>            End
36953>>>>>>
36953>>>>>        End
36953>>>>>>
36953>>>>>        Else Begin
36954>>>>>            Error DFERR_WEBAPP_BAD_SESSION_KEY "Session key not known (reload page to recreate session)"
36955>>>>>>
36955>>>>>        End
36955>>>>>>
36955>>>>>        
36955>>>>>        Function_Return bResult
36956>>>>>    End_Function
36957>>>>>    
36957>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
36959>>>>>        If (not(pbPasswordHashing(Self))) Begin
36961>>>>>            Move sPassword to sHash
36962>>>>>            Function_Return True
36963>>>>>        End
36963>>>>>>
36963>>>>>        
36963>>>>>        If (not(CreatePasswordHash(phoCrypto(Self), sPassword, &sHash))) Begin
36965>>>>>            Function_Return False
36966>>>>>        End
36966>>>>>>
36966>>>>>        Move ("V1$" + sHash) to sHash
36967>>>>>        Function_Return True
36968>>>>>    End_Function
36969>>>>>    
36969>>>>>    Function VerifyPasswordHash String sUserPassword String sEnteredPassword Boolean ByRef bShouldUpgrade Returns Boolean
36971>>>>>        If (not(pbPasswordHashing(Self))) Begin
36973>>>>>            Move False to bShouldUpgrade
36974>>>>>            Function_Return (sUserPassword = sEnteredPassword)
36975>>>>>        End
36975>>>>>>
36975>>>>>        
36975>>>>>        String sVersion
36975>>>>>        Move (Left(sUserPassword, 3)) to sVersion
36976>>>>>        If (sVersion = "V1$") Begin
36978>>>>>            If (num_arguments > 2) Move False to bShouldUpgrade
36981>>>>>            Function_Return (VerifyPasswordHash(phoCrypto(Self), sEnteredPassword, Right(sUserPassword, Length(sUserPassword) - 3)))
36982>>>>>        End
36982>>>>>>
36982>>>>>        Else Begin
36983>>>>>            If (num_arguments > 2) Move True to bShouldUpgrade
36986>>>>>            Function_Return False
36987>>>>>        End
36987>>>>>>
36987>>>>>    End_Function
