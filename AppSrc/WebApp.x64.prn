38063>>>        WebSet pbRender of oEditBtn to False
38064>>>        WebSet pbRender of oSaveBtn to False
38065>>>        WebSet pbRender of oCancelChangesBtn to False
38066>>>        WebSet pbRender of oDeleteBtn to False
38067>>>
38067>>>        If (NavigateData.bReadOnly) Begin
38069>>>            WebSet pbRender of oEditBtn to True
38070>>>        End
38070>>>>
38070>>>        Else Begin
38071>>>            WebSet pbRender of oSaveBtn to True
38072>>>            WebSet pbRender of oCancelChangesBtn to True
38073>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38074>>>        End
38074>>>>
