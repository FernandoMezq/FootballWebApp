37570>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
37573>>>        // Close after save
37573>>>        Send NavigateClose Self
37574>>>    End_Procedure
37575>>>
37575>>>    // this will close the view after a delete
37575>>>    Procedure OnViewDeleted Handle hoDDO
37578>>>        Send NavigateClose Self
37579>>>    End_Procedure
37580>>>
37580>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37583>>>        Case Begin
37583>>>            Case (NavigateData.eNavigateType = nfFromMain)
37585>>>                // If from main, this is a propbably a main file Select to Zoom.
37585>>>                Case Break
37586>>>
37586>>>            Case (NavigateData.eNavigateType = nfFromParent)
37589>>>                // If from parent, this is a constrained drill down.
37589>>>                Case Break
37590>>>
37590>>>            Case (NavigateData.eNavigateType = nfFromChild)
37593>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37593>>>                Case Break
37594>>>
37594>>>            Case Else // must be nfUndefined
37594>>>
37594>>>        Case End
37594>>>
37594>>>        Send SetActionButtons
37595>>>
37595>>>    End_Procedure
37596>>>
37596>>>End_Object 
