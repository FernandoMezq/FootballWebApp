36863>>>>>Class cWebSessionManagerStandard is a cWebSessionManager
36864>>>>>    
36864>>>>>    Procedure Construct_Object
36866>>>>>        Handle hoObj
36866>>>>>        
36866>>>>>        Forward Send Construct_Object
36868>>>>>        
36868>>>>>        Set pbSessionCookieHttpOnly to True
36869>>>>>        
36869>>>>>        Property Handle phoUserDD 0      // Handle to the WebAppUser DDO
36870>>>>>        Property Handle phoSessionDD 0   // Handle to the WebAppSession DDO  
36871>>>>>        Property Handle phoCrypto 0      // Handle to the PasswordHasher
36872>>>>>        
36872>>>>>        Get CreateNamed (RefClass(cWebAppUserDataDictionary)) 'oUserDD' to hoObj
36873>>>>>        Set phoUserDD to hoObj
36874>>>>>        
36874>>>>>        Get CreateNamed (RefClass(cWebAppSessionDataDictionary)) 'oSessionDD' to hoObj
36875>>>>>        Set DDO_Server of hoObj to (phoUserDD(Self))
36876>>>>>        Set phoSessionDD to hoObj
36877>>>>>        
36877>>>>>        Property Handle phoCrypto 0   // Handle to the Cryptographer
36878>>>>>        Get CreateNamed (RefClass(cPasswordHasher)) 'oCrypto' to hoObj
36879>>>>>        Set phoCrypto to hoObj
36880>>>>>        
36880>>>>>        Property Boolean pbPasswordHashing True
36881>>>>>        
36881>>>>>        Property Boolean pbCreatingNewSession False
36882>>>>>        Property String psLoginName
36883>>>>>        Property String psUserName ""
36884>>>>>        Property Integer piUserRights 0
36885>>>>>    End_Procedure
36886>>>>>    
36886>>>>>    Procedure End_Construct_Object
36888>>>>>        Forward Send End_Construct_Object
36890>>>>>        
36890>>>>>        Handle hoCrypto
36890>>>>>        Integer iFieldLen
36890>>>>>        If (pbPasswordHashing(Self)) Begin
36892>>>>>            Get phoCrypto to hoCrypto
36893>>>>>            Get_Attribute DF_FIELD_LENGTH of (RefTable(WebAppUser)) (RefTable(WebAppUser.Password)) to iFieldLen
36896>>>>>            If (iFieldLen < (RequiredBufferSize(hoCrypto) + 3)) Begin
36898>>>>>                Error DFERR_PROGRAM "The password field of WebAppUser is not large enough (128)"
36899>>>>>>
36899>>>>>            End
36899>>>>>>
36899>>>>>        End
36899>>>>>>
36899>>>>>    End_Procedure
36900>>>>>    
36900>>>>>    Function CreateSession String sRemoteAddress Returns String
36902>>>>>        String sSessionKey
36902>>>>>        Integer iErr
36902>>>>>        Boolean bLogWebSession
36902>>>>>        Handle hoSessionDD       
36902>>>>>        Get phoSessionDD to hoSessionDD
36903>>>>>        
36903>>>>>        //  Get session key
36903>>>>>        Forward Get CreateSession sRemoteAddress to sSessionKey
36905>>>>>        
36905>>>>>        Get pbLogWebSession to bLogWebSession
36906>>>>>        If not bLogWebSession Begin
36908>>>>>            Function_Return sSessionKey        
36909>>>>>        End
36909>>>>>>
36909>>>>>
36909>>>>>        //  Store session
36909>>>>>        Send Clear of hoSessionDD
36910>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.SessionKey to sSessionKey
36911>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.RemoteAddress to sRemoteAddress
36912>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.Active to "Y"
36913>>>>>        Get Request_Validate of hoSessionDD to iErr
36914>>>>>        If (iErr) Begin
36916>>>>>            // this should not happen. If it does its a programming error
36916>>>>>            Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
36917>>>>>>
36917>>>>>            Function_Return ""
36918>>>>>        End
36918>>>>>>
36918>>>>>        Send Request_Save of hoSessionDD
36919>>>>>        If (Err) Begin
36921>>>>>            // this shouldn't happen, if it does likely a duplicate session key issue, even through request_save already gave an error we give another one to make tracking down easier
36921>>>>>            Error DFERR_PROGRAM C_$WebAppSessionSaveFailed
36922>>>>>>
36922>>>>>            Function_Return ""
36923>>>>>        End
36923>>>>>>
36923>>>>>       
36923>>>>>        Function_Return sSessionKey        
36924>>>>>    End_Function
36925>>>>>    
36925>>>>>    Function ValidateSession String sSessionKey Boolean bOptLoadWebApp Returns Boolean
36927>>>>>        DateTime dtLastAccess dtCurrent
36927>>>>>        TimeSpan tsDiff
36927>>>>>        Integer iErr iSessionTimeout iSpanMinutes
36927>>>>>        Boolean bResult bCreatingNewSession
36927>>>>>        Boolean bLogWebSession bLoadWebApp
36927>>>>>        Integer eLoginMode
36927>>>>>        String sTime
36927>>>>>        Handle hoSessionDD hoUserDD       
36927>>>>>        
36927>>>>>        Move False to bLoadWebApp
36928>>>>>        If (num_arguments >= 2) Begin
36930>>>>>            Move bOptLoadWebApp to bLoadWebApp
36931>>>>>        End
36931>>>>>>
36931>>>>>        
36931>>>>>        Get phoSessionDD to hoSessionDD
36932>>>>>        Get phoUserDD to hoUserDD
36933>>>>>        
36933>>>>>        Get pbLogWebSession to bLogWebSession
36934>>>>>        Get peLoginMode to eLoginMode
36935>>>>>        
36935>>>>>        // for this object, you can only disable logging if login completely is disabled
36935>>>>>        If (not(bLogWebSession) and (eLoginMode<>lmLoginNone)) Begin
36937>>>>>            Error DFERR_PROGRAM C_$WebSessionLoggingMustBeEnabled
36938>>>>>>
36938>>>>>            Function_Return False
36939>>>>>        End
36939>>>>>>
36939>>>>>
36939>>>>>        //  Clear session properties
36939>>>>>        Set psSessionKey to ""
36940>>>>>        Send UpdateSessionProperties True
36941>>>>>        
36941>>>>>        If not bLogWebSession Begin
36943>>>>>            Forward Get ValidateSession sSessionKey to bResult
36945>>>>>            Function_Return bResult
36946>>>>>        End        
36946>>>>>>
36946>>>>>        
36946>>>>>        Move False to bResult
36947>>>>>        Get piSessionTimeout to iSessionTimeout 
36948>>>>>        
36948>>>>>        //  Check if session exists
36948>>>>>        Send Clear of hoSessionDD
36949>>>>>        Move sSessionKey to WebAppSession.SessionKey
36950>>>>>        Send Find of hoSessionDD EQ Index.1
36951>>>>>            
36951>>>>>        If (Found) Begin
36953>>>>>            //  Calculate timespan between now and last access time
36953>>>>>            Move (CurrentDateTime()) to dtCurrent
36954>>>>>            Move WebAppSession.LastAccessDate to dtLastAccess
36955>>>>>            Get StringToTime of hoSessionDD dtLastAccess WebAppSession.LastAccessTime to dtLastAccess
36956>>>>>            Move (dtCurrent - dtLastAccess) to tsDiff
36957>>>>>            Move (SpanTotalMinutes(tsDiff)) to iSpanMinutes
36958>>>>>            
36958>>>>>            //  Check if session didn't time out
36958>>>>>            If (IsDateValid(dtLastAccess) and (iSessionTimeout <= 0 or (iSpanMinutes < iSessionTimeout)) and WebAppSession.Active = "Y") Begin
36960>>>>>                Forward Get ValidateSession sSessionKey to bResult
36962>>>>>                   
36962>>>>>                If (bResult) Begin
36964>>>>>                    //  Update session record
36964>>>>>                    Get TimeToString of hoSessionDD dtCurrent to sTime 
36965>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessDate to dtCurrent
36966>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessTime to sTime
36967>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.UseCount to (WebAppSession.UseCount + 1)
36968>>>>>                    Get Request_Validate of hoSessionDD to iErr
36969>>>>>                    If (iErr) Begin
36971>>>>>                        // this should not happen. If it does its a programming error
36971>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
36972>>>>>>
36972>>>>>                        Function_Return False
36973>>>>>                    End
36973>>>>>>
36973>>>>>                    Send Request_Save of hoSessionDD
36974>>>>>                    
36974>>>>>                    //  Update user properties
36974>>>>>                    Send UpdateSessionProperties False
36975>>>>>                End
36975>>>>>>
36975>>>>>            End
36975>>>>>>
36975>>>>>            Else Begin
36976>>>>>                // Test the Creating New Session Flag to protect against infinite recursion....
36976>>>>>                Get pbCreatingNewSession to bCreatingNewSession
36977>>>>>                
36977>>>>>                If (not(bCreatingNewSession)) Begin
36979>>>>>                    If (not(bLoadWebApp)) Begin
36981>>>>>                        Move False to bResult   //  We can only continue immediately if we were loading the webapp, other operations are not allowed!
36982>>>>>                        Error DFERR_WEBAPP_SESSION_TIMEOUT "Your application session has timed out or is inactive, please login again."
36983>>>>>>
36983>>>>>                        Send NavigateRefresh of ghoWebApp          // refresh the WebApp at the client (triggers a login)
36984>>>>>                    End
36984>>>>>>
36984>>>>>                    Else Begin
36985>>>>>                        Set pbCreatingNewSession to True                    
36986>>>>>                        Get RecreateSession of ghoWebApp to bResult 
36987>>>>>                        Set pbCreatingNewSession to False                        
36988>>>>>                    End
36988>>>>>>
36988>>>>>                End
36988>>>>>>
36988>>>>>            End
36988>>>>>>
36988>>>>>        End
36988>>>>>>
36988>>>>>        Else Begin
36989>>>>>            Error DFERR_WEBAPP_BAD_SESSION_KEY "Session key not known (reload page to recreate session)"
36990>>>>>>
36990>>>>>        End
36990>>>>>>
36990>>>>>        
36990>>>>>        Function_Return bResult
36991>>>>>    End_Function
36992>>>>>    
36992>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
36994>>>>>        If (not(pbPasswordHashing(Self))) Begin
36996>>>>>            Move sPassword to sHash
36997>>>>>            Function_Return True
36998>>>>>        End
36998>>>>>>
36998>>>>>        
36998>>>>>        If (not(CreatePasswordHash(phoCrypto(Self), sPassword, &sHash))) Begin
37000>>>>>            Function_Return False
37001>>>>>        End
37001>>>>>>
37001>>>>>        Move ("V1$" + sHash) to sHash
37002>>>>>        Function_Return True
37003>>>>>    End_Function
37004>>>>>    
37004>>>>>    Function VerifyPasswordHash String sUserPassword String sEnteredPassword Boolean ByRef bShouldUpgrade Returns Boolean
37006>>>>>        If (not(pbPasswordHashing(Self))) Begin
37008>>>>>            Move False to bShouldUpgrade
37009>>>>>            Function_Return (sUserPassword = sEnteredPassword)
37010>>>>>        End
37010>>>>>>
37010>>>>>        
37010>>>>>        String sVersion
37010>>>>>        Move (Left(sUserPassword, 3)) to sVersion
37011>>>>>        If (sVersion = "V1$") Begin
37013>>>>>            If (num_arguments > 2) Move False to bShouldUpgrade
37016>>>>>            Function_Return (VerifyPasswordHash(phoCrypto(Self), sEnteredPassword, Right(sUserPassword, Length(sUserPassword) - 3)))
37017>>>>>        End
37017>>>>>>
37017>>>>>        Else Begin
37018>>>>>            If (num_arguments > 2) Move True to bShouldUpgrade
37021>>>>>            Function_Return False
37022>>>>>        End
37022>>>>>>
37022>>>>>    End_Function
37023>>>>>    
37023>>>>>    Function UserRegister String sLoginName String sPassword Returns Boolean
37025>>>>>        Handle hoUserDD
37025>>>>>        Integer iErr
37025>>>>>        Get phoUserDD to hoUserDD
37026>>>>>        
37026>>>>>        //  Find the user
37026>>>>>        Send Clear of hoUserDD
37027>>>>>        Move sLoginName to WebAppUser.LoginName
37028>>>>>        Send Find of hoUserDD EQ Index.1
37029>>>>>        If (Found) Begin
37031>>>>>            Send Clear of hoUserDD
37032>>>>>            Function_Return False
37033>>>>>        End
37033>>>>>>
37033>>>>>        
37033>>>>>        Send Clear of hoUserDD
37034>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.FullName to sLoginName
37035>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.LoginName to sLoginName
37036>>>>>        If (not(CreatePasswordHash(Self, Trim(sPassword), &sPassword))) Begin
37038>>>>>            Send Clear of hoUserDD
37039>>>>>            Function_Return False
37040>>>>>        End
37040>>>>>>
37040>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37041>>>>>        Get Request_Validate of hoUserDD to iErr
37042>>>>>        If (iErr) Begin
37044>>>>>            Send Clear of hoUserDD
37045>>>>>            Function_Return False
37046>>>>>        End
37046>>>>>>
37046>>>>>        
37046>>>>>        Send Request_Save of hoUserDD
37047>>>>>        Function_Return (not(Err))
37048>>>>>    End_Function
37049>>>>>    
37049>>>>>    Function UserLogin String sLoginName String sPassword Returns Boolean
37051>>>>>        String sSessionKey sUserPassword
37051>>>>>        Handle hoSessionDD hoUserDD
37051>>>>>        Boolean bMatch bUpgrade
37051>>>>>        
37051>>>>>        Get phoSessionDD to hoSessionDD
37052>>>>>        Get phoUserDD to hoUserDD
37053>>>>>        Integer iErr eLoginMode
37053>>>>>        
37053>>>>>        // Refind session record
37053>>>>>        Get psSessionKey to sSessionKey
37054>>>>>        Send Clear of hoSessionDD
37055>>>>>        Move sSessionKey to WebAppSession.SessionKey
37056>>>>>        Send Find of hoSessionDD EQ Index.1
37057>>>>>        
37057>>>>>        If (Found and WebAppSession.SessionKey = sSessionKey) Begin
37059>>>>>            Get peLoginMode to eLoginMode
37060>>>>>            
37060>>>>>            //  Find the user
37060>>>>>            Move sLoginName to WebAppUser.LoginName
37061>>>>>            Send Find of hoUserDD EQ Index.1
37062>>>>>            
37062>>>>>            // Check username and password
37062>>>>>            If (Found and (Lowercase(sLoginName) = Lowercase(Trim(WebAppUser.LoginName)))) Begin
37064>>>>>                Get Field_Current_Value of hoUserDD Field WebAppUser.Password to sUserPassword
37065>>>>>                Get VerifyPasswordHash (Trim(sUserPassword)) (Trim(sPassword)) (&bUpgrade) to bMatch
37066>>>>>                
37066>>>>>                If (bMatch) Begin
37068>>>>>                    // Store the login
37068>>>>>                    If (bUpgrade) Begin
37070>>>>>                        Get CreatePasswordHash (Trim(sPassword)) (&sPassword) to bUpgrade
37071>>>>>                        If (bUpgrade) Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37074>>>>>                    End
37074>>>>>>
37074>>>>>                    Set Field_Changed_Value of hoUserDD Field WebAppUser.LastLogin to (CurrentDateTime())
37075>>>>>                    Get Request_Validate of hoSessionDD to iErr
37076>>>>>                    If (iErr) Begin
37078>>>>>                        // this should not happen. If it does its a programming error
37078>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37079>>>>>>
37079>>>>>                        Function_Return False
37080>>>>>                    End
37080>>>>>>
37080>>>>>                    
37080>>>>>                    Send Request_Save of hoSessionDD
37081>>>>>                    
37081>>>>>                    // Update session properties
37081>>>>>                    Send UpdateSessionProperties False
37082>>>>>                    Send NotifyChangeRights
37083>>>>>                    Function_Return True
37084>>>>>                End
37084>>>>>>
37084>>>>>                Else Begin
37085>>>>>                    //  We should rely directly on this buffer elsewhere but just be sure
37085>>>>>                    Send Clear of hoUserDD
37086>>>>>                End
37086>>>>>>
37086>>>>>            End
37086>>>>>>
37086>>>>>            Else Begin
37087>>>>>                // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37087>>>>>                Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37088>>>>>            End
37088>>>>>>
37088>>>>>        End
37088>>>>>>
37088>>>>>        Else Begin
37089>>>>>            // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37089>>>>>            Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37090>>>>>        End
37090>>>>>>
37090>>>>>          
37090>>>>>        Function_Return False
37091>>>>>    End_Function
37092>>>>>    
37092>>>>>    Function SetUserPassword String sLoginName String sPassword Returns Boolean
37094>>>>>        Handle hoUserDD
37094>>>>>        Integer iErr
37094>>>>>        Get phoUserDD to hoUserDD
37095>>>>>        
37095>>>>>        //  Find the user
