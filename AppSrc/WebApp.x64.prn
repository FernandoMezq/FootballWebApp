38957>>>    Procedure SetActionButtons
38960>>>        tWebNavigateData NavigateData
38960>>>        tWebNavigateData NavigateData
38960>>>        Boolean bHasRecord
38960>>>        Handle hoDD
38960>>>
38960>>>        Get Server to hoDD
38961>>>        Get GetNavigateData to NavigateData
38962>>>        Get HasRecord of hoDD to bHasRecord
38963>>>
38963>>>        // let's hide all buttons and then Show the ones we want
38963>>>        WebSet pbRender of oEditBtn to False
38964>>>        WebSet pbRender of oSaveBtn to False
38965>>>        WebSet pbRender of oCancelChangesBtn to False
38966>>>        WebSet pbRender of oDeleteBtn to False
38967>>>
38967>>>        If (NavigateData.bReadOnly) Begin
38969>>>            WebSet pbRender of oEditBtn to True
38970>>>        End
38970>>>>
38970>>>        Else Begin
38971>>>            WebSet pbRender of oSaveBtn to True
38972>>>            WebSet pbRender of oCancelChangesBtn to True
38973>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38974>>>        End
38974>>>>
38974>>>    End_Procedure
