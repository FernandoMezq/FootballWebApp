37529>>>    Procedure SetActionButtons
37532>>>        tWebNavigateData NavigateData
37532>>>        tWebNavigateData NavigateData
37532>>>        Boolean bHasRecord
37532>>>        Handle hoDD
37532>>>
37532>>>        Get Server to hoDD
37533>>>        Get GetNavigateData to NavigateData
37534>>>        Get HasRecord of hoDD to bHasRecord
37535>>>
37535>>>        // let's hide all buttons and then Show the ones we want
37535>>>        WebSet pbRender of oEditBtn to False
37536>>>        WebSet pbRender of oSaveBtn to False
37537>>>        WebSet pbRender of oCancelChangesBtn to False
37538>>>        WebSet pbRender of oDeleteBtn to False
37539>>>
37539>>>        If (NavigateData.bReadOnly) Begin
37541>>>            WebSet pbRender of oEditBtn to True
37542>>>        End
37542>>>>
37542>>>        Else Begin
37543>>>            WebSet pbRender of oSaveBtn to True
37544>>>            WebSet pbRender of oCancelChangesBtn to True
37545>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37546>>>        End
37546>>>>
37546>>>    End_Procedure
37547>>>
37547>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
37550>>>        // Close after save
37550>>>        Send NavigateClose Self
37551>>>    End_Procedure
37552>>>
37552>>>    // this will close the view after a delete
37552>>>    Procedure OnViewDeleted Handle hoDDO
37555>>>        Send NavigateClose Self
37556>>>    End_Procedure
37557>>>
37557>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37560>>>        Case Begin
37560>>>            Case (NavigateData.eNavigateType = nfFromMain)
37562>>>                // If from main, this is a propbably a main file Select to Zoom.
37562>>>                Case Break
37563>>>
37563>>>            Case (NavigateData.eNavigateType = nfFromParent)
37566>>>                // If from parent, this is a constrained drill down.
37566>>>                Case Break
37567>>>
37567>>>            Case (NavigateData.eNavigateType = nfFromChild)
37570>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37570>>>                Case Break
37571>>>
37571>>>            Case Else // must be nfUndefined
37571>>>
37571>>>        Case End
37571>>>
37571>>>        Send SetActionButtons
37572>>>
37572>>>    End_Procedure
37573>>>
37573>>>End_Object 
