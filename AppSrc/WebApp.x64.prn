36712>>>>>>>                If (not(bOk)) Function_Return False
36715>>>>>>>                
36715>>>>>>>                Move True to bRequireTimeCost
36716>>>>>>>                Case Break
36717>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36720>>>>>>>                Get CNG_PBKDF2_HMAC "SHA512" (StringToUCharArray(sPassword)) ucaSalt uiOptTimeCost (&ucaHash) False to bOk
36721>>>>>>>                If (not(bOk)) Function_Return False
36724>>>>>>>                
36724>>>>>>>                Move True to bRequireTimeCost
36725>>>>>>>                Case Break
36726>>>>>>>            Case Else
36726>>>>>>>                Error 8710 "Invalid algorithm selected."
36727>>>>>>>>
36727>>>>>>>                Function_Return False
36728>>>>>>>        Case End
36728>>>>>>>        
36728>>>>>>>        String sSalt
36728>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
36729>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return False
36732>>>>>>>        Get Base64EncodeArr ucaHash to sHash
36733>>>>>>>        If (not(SizeOfString(sHash))) Function_Return False
36736>>>>>>>        
36736>>>>>>>        If (bRequireTimeCost) Begin
36738>>>>>>>            Move (SFormat("%1$%2$%3$%4",            ;                            String(uiAlgo),         ;                            sSalt,                  ;                            String(uiOptTimeCost),  ;                            sHash)) to sHash
36739>>>>>>>        End
36739>>>>>>>>
36739>>>>>>>        Else Begin
36740>>>>>>>            Move (SFormat("%1$%2$%3",               ;                            String(uiAlgo),         ;                            sSalt,                  ;                            sHash)) to sHash
36741>>>>>>>        End
36741>>>>>>>>
36741>>>>>>>        
36741>>>>>>>        Function_Return bOk
36742>>>>>>>    End_Function
36743>>>>>>>    
36743>>>>>>>    Function CreatePasswordHashEx UInteger uiAlgo UInteger uiSaltSize String sPassword String ByRef sHash UInteger uiOptTimeCost Returns Boolean
36745>>>>>>>        UChar[] ucaSalt
36746>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36747>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36750>>>>>>>        
36750>>>>>>>        If (num_arguments > 4) Begin
36752>>>>>>>            Function_Return (CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sHash, uiOptTimeCost))
36753>>>>>>>        End
36753>>>>>>>>
36753>>>>>>>        Function_Return (CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sHash))
36754>>>>>>>    End_Function
36755>>>>>>>    
36755>>>>>>>    Function VerifyPasswordHash String sPassword String sHash Returns Boolean
36757>>>>>>>        Boolean bRequiresTimeCost
36757>>>>>>>        UInteger uiAlgo uiTimeCost
36757>>>>>>>        Integer iBegin iEnd
36757>>>>>>>        String sSalt
36757>>>>>>>        
36757>>>>>>>        Move 1 to iBegin
36758>>>>>>>        
36758>>>>>>>        // Parse Algo
36758>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36759>>>>>>>        If (not(iEnd)) Function_Return False
36762>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiAlgo
36763>>>>>>>        
36763>>>>>>>        // Parse Salt
36763>>>>>>>        Move (iEnd + 1) to iBegin
36764>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36765>>>>>>>        If (not(iEnd)) Function_Return False
36768>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to sSalt
36769>>>>>>>        
36769>>>>>>>        Case Begin
36769>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36771>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36774>>>>>>>                Move True to bRequiresTimeCost
36775>>>>>>>                Case Break
36776>>>>>>>            Case Else
36776>>>>>>>                Error 8710 "Invalid algorithm selected."
36777>>>>>>>>
36777>>>>>>>                Function_Return False
36778>>>>>>>        Case End
36778>>>>>>>        
36778>>>>>>>        // Parse optional timecost
36778>>>>>>>        If (bRequiresTimeCost) Begin
36780>>>>>>>            Move (iEnd + 1) to iBegin
36781>>>>>>>            Move (Pos("$", sHash, iBegin)) to iEnd
36782>>>>>>>            If (not(iEnd)) Function_Return False
36785>>>>>>>            Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiTimeCost
36786>>>>>>>        End
36786>>>>>>>>
36786>>>>>>>        
36786>>>>>>>        // Parse rest hash
36786>>>>>>>        Move (iEnd + 1) to iBegin
36787>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36788>>>>>>>        If (iEnd) Function_Return False // inverse check if there are any other errors.
36791>>>>>>>        
36791>>>>>>>        // Base64Decode
36791>>>>>>>        UChar[] ucaSalt
36792>>>>>>>        Get Base64DecodeArr sSalt to ucaSalt
36793>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36796>>>>>>>        
36796>>>>>>>        // Create new hash
36796>>>>>>>        String sNewHash
36796>>>>>>>        If (bRequiresTimeCost) Begin
36798>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash, uiTimeCost))) Begin
36800>>>>>>>                Function_Return False 
36801>>>>>>>            End
36801>>>>>>>>
36801>>>>>>>        End
36801>>>>>>>>
36801>>>>>>>        Else Begin
36802>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash))) Begin
36804>>>>>>>                Function_Return False 
36805>>>>>>>            End
36805>>>>>>>>
36805>>>>>>>        End
36805>>>>>>>>
36805>>>>>>>        Function_Return (sNewHash = sHash)
36806>>>>>>>    End_Function
36807>>>>>>>    
36807>>>>>>>    Function RequiredBufferSizeEx UInteger uiAlgo UInteger uiSaltSize UInteger uiOptTimeCost Returns UBigInt
36809>>>>>>>        Boolean bRequireTimeCost
36809>>>>>>>        UBigInt ullSize
36809>>>>>>>        UChar[] ucaSalt
36810>>>>>>>        String sSalt
36810>>>>>>>        
36810>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36811>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
36812>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return 0
36815>>>>>>>        
36815>>>>>>>        Case Begin
36815>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36817>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA256" to ullSize
36818>>>>>>>                Move True to bRequireTimeCost
36819>>>>>>>                Case Break
36820>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36823>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA512" to ullSize
36824>>>>>>>                Move True to bRequireTimeCost
36825>>>>>>>                Case Break
36826>>>>>>>            Case Else
36826>>>>>>>                Error 8710 "Invalid algorithm selected."
36827>>>>>>>>
36827>>>>>>>                Function_Return 0
36828>>>>>>>        Case End
36828>>>>>>>        
36828>>>>>>>        // calculate base64 in a non-floating-manner
36828>>>>>>>        Move (((ullSize + 3 -1) / 3) * 4) to ullSize
36829>>>>>>>        
36829>>>>>>>        Move (ullSize + SizeOfString(String(uiAlgo))) to ullSize
36830>>>>>>>        Move (ullSize + SizeOfString(sSalt)) to ullSize
36831>>>>>>>        If (bRequireTimeCost) Begin
36833>>>>>>>            Move (ullSize + SizeOfString(String(uiOptTimeCost))) to ullSize
36834>>>>>>>            Move (ullSize + 3 /*$*/) to ullSize
36835>>>>>>>        End
36835>>>>>>>>
36835>>>>>>>        Else Begin
36836>>>>>>>            Move (ullSize + 2 /*$*/) to ullSize
36837>>>>>>>        End
36837>>>>>>>>
36837>>>>>>>        
36837>>>>>>>        Function_Return ullSize
36838>>>>>>>    End_Function
36839>>>>>>>End_Class
36840>>>>>>>
36840>>>>>>>Class cPasswordHasher is a cObject
36841>>>>>>>    
36841>>>>>>>    Import_Class_Protocol cPasswordHasher_Mixin
36842>>>>>>>    
36842>>>>>>>    Procedure Construct_Object
36844>>>>>>>        Forward Send Construct_Object
36846>>>>>>>        
36846>>>>>>>        Property UInteger   peAlgorithm         C_PWH_PBKDF2_HMAC_SHA_512 
36847>>>>>>>        Property UInteger   puiSaltSize         16
36848>>>>>>>        
36848>>>>>>>        Property UInteger   puiOptTimeCost      420000
36849>>>>>>>    End_Procedure
36850>>>>>>>    
36850>>>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
36852>>>>>>>        Boolean bOk
36852>>>>>>>        UInteger uiAlgo
36852>>>>>>>        Get peAlgorithm to uiAlgo
36853>>>>>>>        
36853>>>>>>>        Case Begin
36853>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36855>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36858>>>>>>>                Get CreatePasswordHashEx uiAlgo (puiSaltSize(Self)) sPassword (&sHash) (puiOptTimeCost(Self)) to bOk
36859>>>>>>>                Case Break
36860>>>>>>>            Case Else
36860>>>>>>>                Error 8710 "Invalid algorithm selected."
36861>>>>>>>>
36861>>>>>>>                Function_Return False
36862>>>>>>>        Case End
36862>>>>>>>        
36862>>>>>>>        Function_Return bOk
36863>>>>>>>    End_Function
36864>>>>>>>    
36864>>>>>>>    Function RequiredBufferSize Returns UBigInt
36866>>>>>>>        UBigInt ullSize
36866>>>>>>>        UInteger uiAlgo
36866>>>>>>>        Get peAlgorithm to uiAlgo
36867>>>>>>>        
36867>>>>>>>        Case Begin
36867>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36869>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36872>>>>>>>                Get RequiredBufferSizeEx uiAlgo (puiSaltSize(Self)) (puiOptTimeCost(Self)) to ullSize
36873>>>>>>>                Case Break
36874>>>>>>>            Case Else
36874>>>>>>>                Error 8710 "Invalid algorithm selected."
36875>>>>>>>>
36875>>>>>>>                Function_Return 0
36876>>>>>>>        Case End
36876>>>>>>>        
36876>>>>>>>        Function_Return ullSize
36877>>>>>>>    End_Function
36878>>>>>>>
36878>>>>>>>End_Class
