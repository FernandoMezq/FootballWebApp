38998>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38998>>>                Case Break
38999>>>
38999>>>            Case Else // must be nfUndefined
38999>>>
38999>>>        Case End
38999>>>
38999>>>        Send SetActionButtons
