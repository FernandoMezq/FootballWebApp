36565>>>>>>>    //
36565>>>>>>>    Function StringToTime DateTime dtTime String sTimeString Returns DateTime
36567>>>>>>>        String sHours sMinutes sSeconds
36567>>>>>>>        
36567>>>>>>>        //  Extract parts
36567>>>>>>>        Move (Mid(sTimeString, 2, 1)) to sHours
36568>>>>>>>        Move (Mid(sTimeString, 2, 4)) to sMinutes
36569>>>>>>>        Move (Mid(sTimeString, 2, 7)) to sSeconds
36570>>>>>>>        
36570>>>>>>>        //  Set to DateTime
36570>>>>>>>        Move (DateSetHour(dtTime, (Integer(sHours)))) to dtTime
36571>>>>>>>        Move (DateSetMinute(dtTime, (Integer(sMinutes)))) to dtTime
36572>>>>>>>        Move (DateSetSecond(dtTime, (Integer(sSeconds)))) to dtTime
36573>>>>>>>        
36573>>>>>>>        Function_Return dtTime
36574>>>>>>>    End_Function
