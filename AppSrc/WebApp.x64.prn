37954>>>    Procedure SetActionButtons
37957>>>        tWebNavigateData NavigateData
37957>>>        tWebNavigateData NavigateData
37957>>>        Boolean bHasRecord
37957>>>        Handle hoDD
37957>>>
37957>>>        Get Server to hoDD
37958>>>        Get GetNavigateData to NavigateData
37959>>>        Get HasRecord of hoDD to bHasRecord
37960>>>
37960>>>        // let's hide all buttons and then Show the ones we want
37960>>>        WebSet pbRender of oEditBtn to False
37961>>>        WebSet pbRender of oSaveBtn to False
37962>>>        WebSet pbRender of oCancelChangesBtn to False
37963>>>        WebSet pbRender of oDeleteBtn to False
37964>>>
37964>>>        If (NavigateData.bReadOnly) Begin
37966>>>            WebSet pbRender of oEditBtn to True
37967>>>        End
37967>>>>
37967>>>        Else Begin
37968>>>            WebSet pbRender of oSaveBtn to True
37969>>>            WebSet pbRender of oCancelChangesBtn to True
37970>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37971>>>        End
37971>>>>
37971>>>    End_Procedure
