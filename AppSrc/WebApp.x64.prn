37285>>>        
37285>>>       
37285>>>        Get StateHash of ghoWebApp to sPrevStateHash
37286>>>        Send ParseViewStateHash sPrevStateHash (&sView)
37287>>>        If (Lowercase(sView) <> Lowercase(psStateViewName(Self))) Begin
37289>>>            WebSet psPrevStateHash to sPrevStateHash
37290>>>        End
37290>>>>
37290>>>        
37290>>>    End_Procedure
