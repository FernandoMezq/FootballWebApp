37256>>>    Procedure DoLogin
37259>>>        String sLoginName sPassword sPrevStateHash
37259>>>        Boolean bResult
37259>>>        
37259>>>        WebGet psValue of oLoginName to sLoginName
37260>>>        WebGet psValue of oPassword to sPassword
37261>>>        
37261>>>        Get UserLogin of ghoWebSessionManager sLoginName sPassword to bResult
37262>>>        
37262>>>        If (bResult) Begin
37264>>>            Send Hide of oLogin
37265>>>            Send ShowHeader of ghoWebApp
37266>>>            WebSet psCSSClass of ghoWebApp to ""
37267>>>            
37267>>>            WebGet psPrevStateHash to sPrevStateHash
37268>>>            Send NavigateToStateHash of ghoWebApp sPrevStateHash True
37269>>>            
37269>>>            
37269>>>            WebSet psValue of oLoginName to ""
37270>>>            WebSet psValue of oPassword  to ""
37271>>>            WebSet pbVisible of oWarning to False
37272>>>        End
37272>>>>
37272>>>        Else Begin
37273>>>            WebSet pbVisible of oWarning to True
37274>>>        End
37274>>>>
37274>>>    End_Procedure
37275>>>    
37275>>>    Procedure OnSubmit
37278>>>        Send DoLogin
37279>>>    End_Procedure
