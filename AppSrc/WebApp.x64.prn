38933>>>    Procedure SetActionButtons
38936>>>        tWebNavigateData NavigateData
38936>>>        tWebNavigateData NavigateData
38936>>>        Boolean bHasRecord
38936>>>        Handle hoDD
38936>>>
38936>>>        Get Server to hoDD
38937>>>        Get GetNavigateData to NavigateData
38938>>>        Get HasRecord of hoDD to bHasRecord
38939>>>
38939>>>        // let's hide all buttons and then Show the ones we want
38939>>>        WebSet pbRender of oEditBtn to False
38940>>>        WebSet pbRender of oSaveBtn to False
38941>>>        WebSet pbRender of oCancelChangesBtn to False
38942>>>        WebSet pbRender of oDeleteBtn to False
38943>>>
38943>>>        If (NavigateData.bReadOnly) Begin
38945>>>            WebSet pbRender of oEditBtn to True
38946>>>        End
38946>>>>
38946>>>        Else Begin
38947>>>            WebSet pbRender of oSaveBtn to True
38948>>>            WebSet pbRender of oCancelChangesBtn to True
38949>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38950>>>        End
38950>>>>
38950>>>    End_Procedure
