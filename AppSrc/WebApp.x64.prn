36692>>>>>>>    Function CreatePasswordHashEx UInteger uiAlgo UInteger uiSaltSize String sPassword String ByRef sHash UInteger uiOptTimeCost Returns Boolean
36694>>>>>>>        UChar[] ucaSalt
36695>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36696>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36699>>>>>>>        
36699>>>>>>>        If (num_arguments > 4) Begin
36701>>>>>>>            Function_Return (CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sHash, uiOptTimeCost))
36702>>>>>>>        End
36702>>>>>>>>
36702>>>>>>>        Function_Return (CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sHash))
36703>>>>>>>    End_Function
36704>>>>>>>    
36704>>>>>>>    Function VerifyPasswordHash String sPassword String sHash Returns Boolean
36706>>>>>>>        Boolean bRequiresTimeCost
36706>>>>>>>        UInteger uiAlgo uiTimeCost
36706>>>>>>>        Integer iBegin iEnd
36706>>>>>>>        String sSalt
36706>>>>>>>        
36706>>>>>>>        Move 1 to iBegin
36707>>>>>>>        
36707>>>>>>>        // Parse Algo
36707>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36708>>>>>>>        If (not(iEnd)) Function_Return False
36711>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiAlgo
36712>>>>>>>        
36712>>>>>>>        // Parse Salt
36712>>>>>>>        Move (iEnd + 1) to iBegin
36713>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36714>>>>>>>        If (not(iEnd)) Function_Return False
36717>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to sSalt
36718>>>>>>>        
36718>>>>>>>        Case Begin
36718>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36720>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36723>>>>>>>                Move True to bRequiresTimeCost
36724>>>>>>>                Case Break
36725>>>>>>>            Case Else
36725>>>>>>>                Error 8710 "Invalid algorithm selected."
36726>>>>>>>>
36726>>>>>>>                Function_Return False
36727>>>>>>>        Case End
36727>>>>>>>        
36727>>>>>>>        // Parse optional timecost
36727>>>>>>>        If (bRequiresTimeCost) Begin
36729>>>>>>>            Move (iEnd + 1) to iBegin
36730>>>>>>>            Move (Pos("$", sHash, iBegin)) to iEnd
36731>>>>>>>            If (not(iEnd)) Function_Return False
36734>>>>>>>            Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiTimeCost
36735>>>>>>>        End
36735>>>>>>>>
36735>>>>>>>        
36735>>>>>>>        // Parse rest hash
36735>>>>>>>        Move (iEnd + 1) to iBegin
36736>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36737>>>>>>>        If (iEnd) Function_Return False // inverse check if there are any other errors.
36740>>>>>>>        
36740>>>>>>>        // Base64Decode
36740>>>>>>>        UChar[] ucaSalt
36741>>>>>>>        Get Base64DecodeArr sSalt to ucaSalt
36742>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36745>>>>>>>        
36745>>>>>>>        // Create new hash
36745>>>>>>>        String sNewHash
36745>>>>>>>        If (bRequiresTimeCost) Begin
36747>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash, uiTimeCost))) Begin
36749>>>>>>>                Function_Return False 
36750>>>>>>>            End
36750>>>>>>>>
36750>>>>>>>        End
36750>>>>>>>>
36750>>>>>>>        Else Begin
36751>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash))) Begin
36753>>>>>>>                Function_Return False 
36754>>>>>>>            End
36754>>>>>>>>
36754>>>>>>>        End
36754>>>>>>>>
36754>>>>>>>        Function_Return (sNewHash = sHash)
36755>>>>>>>    End_Function
36756>>>>>>>    
36756>>>>>>>    Function RequiredBufferSizeEx UInteger uiAlgo UInteger uiSaltSize UInteger uiOptTimeCost Returns UBigInt
36758>>>>>>>        Boolean bRequireTimeCost
36758>>>>>>>        UBigInt ullSize
36758>>>>>>>        UChar[] ucaSalt
36759>>>>>>>        String sSalt
36759>>>>>>>        
36759>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36760>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
36761>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return 0
36764>>>>>>>        
36764>>>>>>>        Case Begin
36764>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36766>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA256" to ullSize
36767>>>>>>>                Move True to bRequireTimeCost
36768>>>>>>>                Case Break
36769>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36772>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA512" to ullSize
36773>>>>>>>                Move True to bRequireTimeCost
36774>>>>>>>                Case Break
36775>>>>>>>            Case Else
36775>>>>>>>                Error 8710 "Invalid algorithm selected."
36776>>>>>>>>
36776>>>>>>>                Function_Return 0
36777>>>>>>>        Case End
36777>>>>>>>        
36777>>>>>>>        // calculate base64 in a non-floating-manner
36777>>>>>>>        Move (((ullSize + 3 -1) / 3) * 4) to ullSize
36778>>>>>>>        
36778>>>>>>>        Move (ullSize + SizeOfString(String(uiAlgo))) to ullSize
36779>>>>>>>        Move (ullSize + SizeOfString(sSalt)) to ullSize
36780>>>>>>>        If (bRequireTimeCost) Begin
36782>>>>>>>            Move (ullSize + SizeOfString(String(uiOptTimeCost))) to ullSize
36783>>>>>>>            Move (ullSize + 3 /*$*/) to ullSize
36784>>>>>>>        End
36784>>>>>>>>
36784>>>>>>>        Else Begin
36785>>>>>>>            Move (ullSize + 2 /*$*/) to ullSize
36786>>>>>>>        End
36786>>>>>>>>
36786>>>>>>>        
36786>>>>>>>        Function_Return ullSize
36787>>>>>>>    End_Function
36788>>>>>>>End_Class
36789>>>>>>>
36789>>>>>>>Class cPasswordHasher is a cObject
36790>>>>>>>    
36790>>>>>>>    Import_Class_Protocol cPasswordHasher_Mixin
36791>>>>>>>    
36791>>>>>>>    Procedure Construct_Object
36793>>>>>>>        Forward Send Construct_Object
36795>>>>>>>        
36795>>>>>>>        Property UInteger   peAlgorithm         C_PWH_PBKDF2_HMAC_SHA_512 
36796>>>>>>>        Property UInteger   puiSaltSize         16
36797>>>>>>>        
36797>>>>>>>        Property UInteger   puiOptTimeCost      420000
36798>>>>>>>    End_Procedure
36799>>>>>>>    
36799>>>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
36801>>>>>>>        Boolean bOk
36801>>>>>>>        UInteger uiAlgo
36801>>>>>>>        Get peAlgorithm to uiAlgo
36802>>>>>>>        
36802>>>>>>>        Case Begin
36802>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36804>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36807>>>>>>>                Get CreatePasswordHashEx uiAlgo (puiSaltSize(Self)) sPassword (&sHash) (puiOptTimeCost(Self)) to bOk
36808>>>>>>>                Case Break
36809>>>>>>>            Case Else
36809>>>>>>>                Error 8710 "Invalid algorithm selected."
36810>>>>>>>>
36810>>>>>>>                Function_Return False
36811>>>>>>>        Case End
36811>>>>>>>        
36811>>>>>>>        Function_Return bOk
36812>>>>>>>    End_Function
36813>>>>>>>    
36813>>>>>>>    Function RequiredBufferSize Returns UBigInt
36815>>>>>>>        UBigInt ullSize
36815>>>>>>>        UInteger uiAlgo
36815>>>>>>>        Get peAlgorithm to uiAlgo
36816>>>>>>>        
36816>>>>>>>        Case Begin
36816>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36818>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36821>>>>>>>                Get RequiredBufferSizeEx uiAlgo (puiSaltSize(Self)) (puiOptTimeCost(Self)) to ullSize
36822>>>>>>>                Case Break
36823>>>>>>>            Case Else
36823>>>>>>>                Error 8710 "Invalid algorithm selected."
36824>>>>>>>>
36824>>>>>>>                Function_Return 0
36825>>>>>>>        Case End
36825>>>>>>>        
36825>>>>>>>        Function_Return ullSize
36826>>>>>>>    End_Function
36827>>>>>>>
36827>>>>>>>End_Class
