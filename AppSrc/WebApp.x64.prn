36565>>>>>>>    //
36565>>>>>>>    //  Converts the given time to an string that can be saved in the database.
36565>>>>>>>    //
36565>>>>>>>    //  Params:
36565>>>>>>>    //      dtTime  Time to convert
36565>>>>>>>    //  Returns:
36565>>>>>>>    //      String with "HH:MM:SS" format
36565>>>>>>>    //
36565>>>>>>>    Function TimeToString DateTime dtTime Returns String
36567>>>>>>>        String sHours sMinutes sSeconds
36567>>>>>>>        
36567>>>>>>>        //  Extract parts
36567>>>>>>>        Move (String(DateGetHour(dtTime))) to sHours
36568>>>>>>>        Move (String(DateGetMinute(dtTime))) to sMinutes
36569>>>>>>>        Move (String(DateGetSecond(dtTime))) to sSeconds
36570>>>>>>>        
36570>>>>>>>        //  Fill out with 0
36570>>>>>>>        If (Length(sHours) = 1) ;            Move ("0" + sHours) to sHours
36573>>>>>>>        If (Length(sMinutes) = 1) ;            Move ("0" + sMinutes) to sMinutes
36576>>>>>>>        If (Length(sSeconds) = 1) ;            Move ("0" + sSeconds) to sSeconds
36579>>>>>>>        
36579>>>>>>>        Function_Return (sHours + ":" + sMinutes + ":" + sSeconds)
36580>>>>>>>    End_Function
36581>>>>>>>    
36581>>>>>>>    //
36581>>>>>>>    //  Sets the time of the datetime variable to the time in the string.
36581>>>>>>>    //
36581>>>>>>>    //  Params:
36581>>>>>>>    //      dtTime  Datetime variable to add time to
36581>>>>>>>    //      sTimeString String with time in the format "HH:MM:SS"
36581>>>>>>>    //  Returns:
36581>>>>>>>    //      dtDateTime with the loaded time
36581>>>>>>>    //
36581>>>>>>>    Function StringToTime DateTime dtTime String sTimeString Returns DateTime
36583>>>>>>>        String sHours sMinutes sSeconds
36583>>>>>>>        
36583>>>>>>>        //  Extract parts
36583>>>>>>>        Move (Mid(sTimeString, 2, 1)) to sHours
36584>>>>>>>        Move (Mid(sTimeString, 2, 4)) to sMinutes
36585>>>>>>>        Move (Mid(sTimeString, 2, 7)) to sSeconds
36586>>>>>>>        
36586>>>>>>>        //  Set to DateTime
36586>>>>>>>        Move (DateSetHour(dtTime, (Integer(sHours)))) to dtTime
36587>>>>>>>        Move (DateSetMinute(dtTime, (Integer(sMinutes)))) to dtTime
36588>>>>>>>        Move (DateSetSecond(dtTime, (Integer(sSeconds)))) to dtTime
36589>>>>>>>        
36589>>>>>>>        Function_Return dtTime
36590>>>>>>>    End_Function
