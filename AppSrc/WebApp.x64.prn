39367>>>    Procedure SetActionButtons
39370>>>        tWebNavigateData NavigateData
39370>>>        tWebNavigateData NavigateData
39370>>>        Boolean bHasRecord
39370>>>        Handle hoDD
39370>>>
39370>>>        Get Server to hoDD
39371>>>        Get GetNavigateData to NavigateData
39372>>>        Get HasRecord of hoDD to bHasRecord
39373>>>
39373>>>        // let's hide all buttons and then Show the ones we want
39373>>>        WebSet pbRender of oEditBtn to False
39374>>>        WebSet pbRender of oSaveBtn to False
39375>>>        WebSet pbRender of oCancelChangesBtn to False
39376>>>        WebSet pbRender of oDeleteBtn to False
39377>>>        WebSet pbRender of oDespedirBtn to True
39378>>>        
39378>>>        If (NavigateData.bReadOnly) Begin
39380>>>            WebSet pbRender of oEditBtn to True
39381>>>        End
39381>>>>
39381>>>        Else Begin
39382>>>            WebSet pbRender of oSaveBtn to True
39383>>>            WebSet pbRender of oCancelChangesBtn to True
39384>>>            WebSet pbRender of oDeleteBtn to bHasRecord
39385>>>            WebSet pbRender of oDespedirBtn to bHasRecord
39386>>>
39386>>>        End
39386>>>>
39386>>>    End_Procedure
