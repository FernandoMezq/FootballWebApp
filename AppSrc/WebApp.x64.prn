36704>>>>>>>                If (not(bOk)) Function_Return False
36707>>>>>>>                
36707>>>>>>>                Move True to bRequireTimeCost
36708>>>>>>>                Case Break
36709>>>>>>>            Case Else
36709>>>>>>>                Error 8710 "Invalid algorithm selected."
36710>>>>>>>>
36710>>>>>>>                Function_Return False
36711>>>>>>>        Case End
36711>>>>>>>        
36711>>>>>>>        String sSalt
36711>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
36712>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return False
36715>>>>>>>        Get Base64EncodeArr ucaHash to sHash
36716>>>>>>>        If (not(SizeOfString(sHash))) Function_Return False
36719>>>>>>>        
36719>>>>>>>        If (bRequireTimeCost) Begin
36721>>>>>>>            Move (SFormat("%1$%2$%3$%4",            ;                            String(uiAlgo),         ;                            sSalt,                  ;                            String(uiOptTimeCost),  ;                            sHash)) to sHash
36722>>>>>>>        End
36722>>>>>>>>
36722>>>>>>>        Else Begin
36723>>>>>>>            Move (SFormat("%1$%2$%3",               ;                            String(uiAlgo),         ;                            sSalt,                  ;                            sHash)) to sHash
36724>>>>>>>        End
36724>>>>>>>>
36724>>>>>>>        
36724>>>>>>>        Function_Return bOk
36725>>>>>>>    End_Function
36726>>>>>>>    
36726>>>>>>>    Function CreatePasswordHashEx UInteger uiAlgo UInteger uiSaltSize String sPassword String ByRef sHash UInteger uiOptTimeCost Returns Boolean
36728>>>>>>>        UChar[] ucaSalt
36729>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36730>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36733>>>>>>>        
36733>>>>>>>        If (num_arguments > 4) Begin
36735>>>>>>>            Function_Return (CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sHash, uiOptTimeCost))
36736>>>>>>>        End
36736>>>>>>>>
36736>>>>>>>        Function_Return (CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sHash))
36737>>>>>>>    End_Function
36738>>>>>>>    
36738>>>>>>>    Function VerifyPasswordHash String sPassword String sHash Returns Boolean
36740>>>>>>>        Boolean bRequiresTimeCost
36740>>>>>>>        UInteger uiAlgo uiTimeCost
36740>>>>>>>        Integer iBegin iEnd
36740>>>>>>>        String sSalt
36740>>>>>>>        
36740>>>>>>>        Move 1 to iBegin
36741>>>>>>>        
36741>>>>>>>        // Parse Algo
36741>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36742>>>>>>>        If (not(iEnd)) Function_Return False
36745>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiAlgo
36746>>>>>>>        
36746>>>>>>>        // Parse Salt
36746>>>>>>>        Move (iEnd + 1) to iBegin
36747>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36748>>>>>>>        If (not(iEnd)) Function_Return False
36751>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to sSalt
36752>>>>>>>        
36752>>>>>>>        Case Begin
36752>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36754>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36757>>>>>>>                Move True to bRequiresTimeCost
36758>>>>>>>                Case Break
36759>>>>>>>            Case Else
36759>>>>>>>                Error 8710 "Invalid algorithm selected."
36760>>>>>>>>
36760>>>>>>>                Function_Return False
36761>>>>>>>        Case End
36761>>>>>>>        
36761>>>>>>>        // Parse optional timecost
36761>>>>>>>        If (bRequiresTimeCost) Begin
36763>>>>>>>            Move (iEnd + 1) to iBegin
36764>>>>>>>            Move (Pos("$", sHash, iBegin)) to iEnd
36765>>>>>>>            If (not(iEnd)) Function_Return False
36768>>>>>>>            Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiTimeCost
36769>>>>>>>        End
36769>>>>>>>>
36769>>>>>>>        
36769>>>>>>>        // Parse rest hash
36769>>>>>>>        Move (iEnd + 1) to iBegin
36770>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36771>>>>>>>        If (iEnd) Function_Return False // inverse check if there are any other errors.
36774>>>>>>>        
36774>>>>>>>        // Base64Decode
36774>>>>>>>        UChar[] ucaSalt
36775>>>>>>>        Get Base64DecodeArr sSalt to ucaSalt
36776>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36779>>>>>>>        
36779>>>>>>>        // Create new hash
36779>>>>>>>        String sNewHash
36779>>>>>>>        If (bRequiresTimeCost) Begin
36781>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash, uiTimeCost))) Begin
36783>>>>>>>                Function_Return False 
36784>>>>>>>            End
36784>>>>>>>>
36784>>>>>>>        End
36784>>>>>>>>
36784>>>>>>>        Else Begin
36785>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash))) Begin
36787>>>>>>>                Function_Return False 
36788>>>>>>>            End
36788>>>>>>>>
36788>>>>>>>        End
36788>>>>>>>>
36788>>>>>>>        Function_Return (sNewHash = sHash)
36789>>>>>>>    End_Function
36790>>>>>>>    
36790>>>>>>>    Function RequiredBufferSizeEx UInteger uiAlgo UInteger uiSaltSize UInteger uiOptTimeCost Returns UBigInt
36792>>>>>>>        Boolean bRequireTimeCost
36792>>>>>>>        UBigInt ullSize
36792>>>>>>>        UChar[] ucaSalt
36793>>>>>>>        String sSalt
36793>>>>>>>        
36793>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36794>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
36795>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return 0
36798>>>>>>>        
36798>>>>>>>        Case Begin
36798>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36800>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA256" to ullSize
36801>>>>>>>                Move True to bRequireTimeCost
36802>>>>>>>                Case Break
36803>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36806>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA512" to ullSize
36807>>>>>>>                Move True to bRequireTimeCost
36808>>>>>>>                Case Break
36809>>>>>>>            Case Else
36809>>>>>>>                Error 8710 "Invalid algorithm selected."
36810>>>>>>>>
36810>>>>>>>                Function_Return 0
36811>>>>>>>        Case End
36811>>>>>>>        
36811>>>>>>>        // calculate base64 in a non-floating-manner
36811>>>>>>>        Move (((ullSize + 3 -1) / 3) * 4) to ullSize
36812>>>>>>>        
36812>>>>>>>        Move (ullSize + SizeOfString(String(uiAlgo))) to ullSize
36813>>>>>>>        Move (ullSize + SizeOfString(sSalt)) to ullSize
36814>>>>>>>        If (bRequireTimeCost) Begin
36816>>>>>>>            Move (ullSize + SizeOfString(String(uiOptTimeCost))) to ullSize
36817>>>>>>>            Move (ullSize + 3 /*$*/) to ullSize
36818>>>>>>>        End
36818>>>>>>>>
36818>>>>>>>        Else Begin
36819>>>>>>>            Move (ullSize + 2 /*$*/) to ullSize
36820>>>>>>>        End
36820>>>>>>>>
36820>>>>>>>        
36820>>>>>>>        Function_Return ullSize
36821>>>>>>>    End_Function
36822>>>>>>>End_Class
36823>>>>>>>
36823>>>>>>>Class cPasswordHasher is a cObject
36824>>>>>>>    
36824>>>>>>>    Import_Class_Protocol cPasswordHasher_Mixin
36825>>>>>>>    
36825>>>>>>>    Procedure Construct_Object
36827>>>>>>>        Forward Send Construct_Object
36829>>>>>>>        
36829>>>>>>>        Property UInteger   peAlgorithm         C_PWH_PBKDF2_HMAC_SHA_512 
36830>>>>>>>        Property UInteger   puiSaltSize         16
36831>>>>>>>        
36831>>>>>>>        Property UInteger   puiOptTimeCost      420000
36832>>>>>>>    End_Procedure
36833>>>>>>>    
36833>>>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
36835>>>>>>>        Boolean bOk
36835>>>>>>>        UInteger uiAlgo
36835>>>>>>>        Get peAlgorithm to uiAlgo
36836>>>>>>>        
36836>>>>>>>        Case Begin
36836>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36838>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36841>>>>>>>                Get CreatePasswordHashEx uiAlgo (puiSaltSize(Self)) sPassword (&sHash) (puiOptTimeCost(Self)) to bOk
36842>>>>>>>                Case Break
36843>>>>>>>            Case Else
36843>>>>>>>                Error 8710 "Invalid algorithm selected."
36844>>>>>>>>
36844>>>>>>>                Function_Return False
36845>>>>>>>        Case End
36845>>>>>>>        
36845>>>>>>>        Function_Return bOk
36846>>>>>>>    End_Function
36847>>>>>>>    
36847>>>>>>>    Function RequiredBufferSize Returns UBigInt
36849>>>>>>>        UBigInt ullSize
36849>>>>>>>        UInteger uiAlgo
36849>>>>>>>        Get peAlgorithm to uiAlgo
36850>>>>>>>        
36850>>>>>>>        Case Begin
36850>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36852>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36855>>>>>>>                Get RequiredBufferSizeEx uiAlgo (puiSaltSize(Self)) (puiOptTimeCost(Self)) to ullSize
36856>>>>>>>                Case Break
36857>>>>>>>            Case Else
36857>>>>>>>                Error 8710 "Invalid algorithm selected."
36858>>>>>>>>
36858>>>>>>>                Function_Return 0
36859>>>>>>>        Case End
36859>>>>>>>        
36859>>>>>>>        Function_Return ullSize
36860>>>>>>>    End_Function
36861>>>>>>>
36861>>>>>>>End_Class
36862>>>>>
36862>>>>>Class cWebSessionManagerStandard is a cWebSessionManager
36863>>>>>    
36863>>>>>    Procedure Construct_Object
36865>>>>>        Handle hoObj
36865>>>>>        
36865>>>>>        Forward Send Construct_Object
36867>>>>>        
36867>>>>>        Set pbSessionCookieHttpOnly to True
36868>>>>>        
36868>>>>>        Property Handle phoUserDD 0      // Handle to the WebAppUser DDO
36869>>>>>        Property Handle phoSessionDD 0   // Handle to the WebAppSession DDO  
36870>>>>>        Property Handle phoCrypto 0      // Handle to the PasswordHasher
36871>>>>>        
36871>>>>>        Get CreateNamed (RefClass(cWebAppUserDataDictionary)) 'oUserDD' to hoObj
36872>>>>>        Set phoUserDD to hoObj
36873>>>>>        
36873>>>>>        Get CreateNamed (RefClass(cWebAppSessionDataDictionary)) 'oSessionDD' to hoObj
36874>>>>>        Set DDO_Server of hoObj to (phoUserDD(Self))
36875>>>>>        Set phoSessionDD to hoObj
36876>>>>>        
36876>>>>>        Property Handle phoCrypto 0   // Handle to the Cryptographer
36877>>>>>        Get CreateNamed (RefClass(cPasswordHasher)) 'oCrypto' to hoObj
36878>>>>>        Set phoCrypto to hoObj
36879>>>>>        
36879>>>>>        Property Boolean pbPasswordHashing True
36880>>>>>        
36880>>>>>        Property Boolean pbCreatingNewSession False
36881>>>>>        Property String psLoginName
36882>>>>>        Property String psUserName ""
36883>>>>>        Property Integer piUserRights 0
36884>>>>>    End_Procedure
36885>>>>>    
36885>>>>>    Procedure End_Construct_Object
36887>>>>>        Forward Send End_Construct_Object
36889>>>>>        
36889>>>>>        Handle hoCrypto
36889>>>>>        Integer iFieldLen
36889>>>>>        If (pbPasswordHashing(Self)) Begin
36891>>>>>            Get phoCrypto to hoCrypto
36892>>>>>            Get_Attribute DF_FIELD_LENGTH of (RefTable(WebAppUser)) (RefTable(WebAppUser.Password)) to iFieldLen
36895>>>>>            If (iFieldLen < (RequiredBufferSize(hoCrypto) + 3)) Begin
36897>>>>>                Error DFERR_PROGRAM "The password field of WebAppUser is not large enough (128)"
36898>>>>>>
36898>>>>>            End
36898>>>>>>
36898>>>>>        End
36898>>>>>>
36898>>>>>    End_Procedure
36899>>>>>    
36899>>>>>    Function CreateSession String sRemoteAddress Returns String
36901>>>>>        String sSessionKey
36901>>>>>        Integer iErr
36901>>>>>        Boolean bLogWebSession
36901>>>>>        Handle hoSessionDD       
36901>>>>>        Get phoSessionDD to hoSessionDD
36902>>>>>        
36902>>>>>        //  Get session key
36902>>>>>        Forward Get CreateSession sRemoteAddress to sSessionKey
36904>>>>>        
36904>>>>>        Get pbLogWebSession to bLogWebSession
36905>>>>>        If not bLogWebSession Begin
36907>>>>>            Function_Return sSessionKey        
36908>>>>>        End
36908>>>>>>
36908>>>>>
36908>>>>>        //  Store session
36908>>>>>        Send Clear of hoSessionDD
36909>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.SessionKey to sSessionKey
36910>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.RemoteAddress to sRemoteAddress
36911>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.Active to "Y"
36912>>>>>        Get Request_Validate of hoSessionDD to iErr
36913>>>>>        If (iErr) Begin
36915>>>>>            // this should not happen. If it does its a programming error
36915>>>>>            Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
36916>>>>>>
36916>>>>>            Function_Return ""
36917>>>>>        End
36917>>>>>>
36917>>>>>        Send Request_Save of hoSessionDD
36918>>>>>        If (Err) Begin
36920>>>>>            // this shouldn't happen, if it does likely a duplicate session key issue, even through request_save already gave an error we give another one to make tracking down easier
36920>>>>>            Error DFERR_PROGRAM C_$WebAppSessionSaveFailed
36921>>>>>>
36921>>>>>            Function_Return ""
36922>>>>>        End
36922>>>>>>
36922>>>>>       
36922>>>>>        Function_Return sSessionKey        
36923>>>>>    End_Function
36924>>>>>    
36924>>>>>    Function ValidateSession String sSessionKey Boolean bOptLoadWebApp Returns Boolean
36926>>>>>        DateTime dtLastAccess dtCurrent
36926>>>>>        TimeSpan tsDiff
36926>>>>>        Integer iErr iSessionTimeout iSpanMinutes
36926>>>>>        Boolean bResult bCreatingNewSession
36926>>>>>        Boolean bLogWebSession bLoadWebApp
36926>>>>>        Integer eLoginMode
36926>>>>>        String sTime
36926>>>>>        Handle hoSessionDD hoUserDD       
36926>>>>>        
36926>>>>>        Move False to bLoadWebApp
36927>>>>>        If (num_arguments >= 2) Begin
36929>>>>>            Move bOptLoadWebApp to bLoadWebApp
36930>>>>>        End
36930>>>>>>
36930>>>>>        
36930>>>>>        Get phoSessionDD to hoSessionDD
36931>>>>>        Get phoUserDD to hoUserDD
36932>>>>>        
36932>>>>>        Get pbLogWebSession to bLogWebSession
36933>>>>>        Get peLoginMode to eLoginMode
36934>>>>>        
36934>>>>>        // for this object, you can only disable logging if login completely is disabled
36934>>>>>        If (not(bLogWebSession) and (eLoginMode<>lmLoginNone)) Begin
36936>>>>>            Error DFERR_PROGRAM C_$WebSessionLoggingMustBeEnabled
36937>>>>>>
36937>>>>>            Function_Return False
36938>>>>>        End
36938>>>>>>
36938>>>>>
36938>>>>>        //  Clear session properties
36938>>>>>        Set psSessionKey to ""
36939>>>>>        Send UpdateSessionProperties True
36940>>>>>        
36940>>>>>        If not bLogWebSession Begin
36942>>>>>            Forward Get ValidateSession sSessionKey to bResult
36944>>>>>            Function_Return bResult
36945>>>>>        End        
36945>>>>>>
36945>>>>>        
36945>>>>>        Move False to bResult
36946>>>>>        Get piSessionTimeout to iSessionTimeout 
36947>>>>>        
36947>>>>>        //  Check if session exists
36947>>>>>        Send Clear of hoSessionDD
36948>>>>>        Move sSessionKey to WebAppSession.SessionKey
36949>>>>>        Send Find of hoSessionDD EQ Index.1
36950>>>>>            
36950>>>>>        If (Found) Begin
36952>>>>>            //  Calculate timespan between now and last access time
36952>>>>>            Move (CurrentDateTime()) to dtCurrent
36953>>>>>            Move WebAppSession.LastAccessDate to dtLastAccess
36954>>>>>            Get StringToTime of hoSessionDD dtLastAccess WebAppSession.LastAccessTime to dtLastAccess
36955>>>>>            Move (dtCurrent - dtLastAccess) to tsDiff
36956>>>>>            Move (SpanTotalMinutes(tsDiff)) to iSpanMinutes
36957>>>>>            
36957>>>>>            //  Check if session didn't time out
36957>>>>>            If (IsDateValid(dtLastAccess) and (iSessionTimeout <= 0 or (iSpanMinutes < iSessionTimeout)) and WebAppSession.Active = "Y") Begin
36959>>>>>                Forward Get ValidateSession sSessionKey to bResult
36961>>>>>                   
36961>>>>>                If (bResult) Begin
36963>>>>>                    //  Update session record
36963>>>>>                    Get TimeToString of hoSessionDD dtCurrent to sTime 
36964>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessDate to dtCurrent
36965>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessTime to sTime
36966>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.UseCount to (WebAppSession.UseCount + 1)
36967>>>>>                    Get Request_Validate of hoSessionDD to iErr
36968>>>>>                    If (iErr) Begin
36970>>>>>                        // this should not happen. If it does its a programming error
36970>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
36971>>>>>>
36971>>>>>                        Function_Return False
36972>>>>>                    End
36972>>>>>>
36972>>>>>                    Send Request_Save of hoSessionDD
36973>>>>>                    
36973>>>>>                    //  Update user properties
36973>>>>>                    Send UpdateSessionProperties False
36974>>>>>                End
36974>>>>>>
36974>>>>>            End
36974>>>>>>
36974>>>>>            Else Begin
36975>>>>>                // Test the Creating New Session Flag to protect against infinite recursion....
36975>>>>>                Get pbCreatingNewSession to bCreatingNewSession
36976>>>>>                
36976>>>>>                If (not(bCreatingNewSession)) Begin
36978>>>>>                    If (not(bLoadWebApp)) Begin
36980>>>>>                        Move False to bResult   //  We can only continue immediately if we were loading the webapp, other operations are not allowed!
36981>>>>>                        Error DFERR_WEBAPP_SESSION_TIMEOUT "Your application session has timed out or is inactive, please login again."
36982>>>>>>
36982>>>>>                        Send NavigateRefresh of ghoWebApp          // refresh the WebApp at the client (triggers a login)
36983>>>>>                    End
36983>>>>>>
36983>>>>>                    Else Begin
36984>>>>>                        Set pbCreatingNewSession to True                    
36985>>>>>                        Get RecreateSession of ghoWebApp to bResult 
36986>>>>>                        Set pbCreatingNewSession to False                        
36987>>>>>                    End
36987>>>>>>
36987>>>>>                End
36987>>>>>>
36987>>>>>            End
36987>>>>>>
36987>>>>>        End
36987>>>>>>
36987>>>>>        Else Begin
36988>>>>>            Error DFERR_WEBAPP_BAD_SESSION_KEY "Session key not known (reload page to recreate session)"
36989>>>>>>
36989>>>>>        End
36989>>>>>>
36989>>>>>        
36989>>>>>        Function_Return bResult
36990>>>>>    End_Function
36991>>>>>    
36991>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
36993>>>>>        If (not(pbPasswordHashing(Self))) Begin
36995>>>>>            Move sPassword to sHash
36996>>>>>            Function_Return True
36997>>>>>        End
36997>>>>>>
36997>>>>>        
36997>>>>>        If (not(CreatePasswordHash(phoCrypto(Self), sPassword, &sHash))) Begin
36999>>>>>            Function_Return False
37000>>>>>        End
37000>>>>>>
37000>>>>>        Move ("V1$" + sHash) to sHash
37001>>>>>        Function_Return True
37002>>>>>    End_Function
37003>>>>>    
37003>>>>>    Function VerifyPasswordHash String sUserPassword String sEnteredPassword Boolean ByRef bShouldUpgrade Returns Boolean
37005>>>>>        If (not(pbPasswordHashing(Self))) Begin
37007>>>>>            Move False to bShouldUpgrade
37008>>>>>            Function_Return (sUserPassword = sEnteredPassword)
37009>>>>>        End
37009>>>>>>
37009>>>>>        
37009>>>>>        String sVersion
37009>>>>>        Move (Left(sUserPassword, 3)) to sVersion
37010>>>>>        If (sVersion = "V1$") Begin
37012>>>>>            If (num_arguments > 2) Move False to bShouldUpgrade
37015>>>>>            Function_Return (VerifyPasswordHash(phoCrypto(Self), sEnteredPassword, Right(sUserPassword, Length(sUserPassword) - 3)))
37016>>>>>        End
37016>>>>>>
37016>>>>>        Else Begin
37017>>>>>            If (num_arguments > 2) Move True to bShouldUpgrade
37020>>>>>            Function_Return False
37021>>>>>        End
37021>>>>>>
37021>>>>>    End_Function
37022>>>>>    
37022>>>>>    Function UserRegister String sLoginName String sPassword Returns Boolean
37024>>>>>        Handle hoUserDD
37024>>>>>        Integer iErr
37024>>>>>        Get phoUserDD to hoUserDD
37025>>>>>        
37025>>>>>        //  Find the user
37025>>>>>        Send Clear of hoUserDD
37026>>>>>        Move sLoginName to WebAppUser.LoginName
37027>>>>>        Send Find of hoUserDD EQ Index.1
37028>>>>>        If (Found) Begin
37030>>>>>            Send Clear of hoUserDD
37031>>>>>            Function_Return False
37032>>>>>        End
37032>>>>>>
37032>>>>>        
37032>>>>>        Send Clear of hoUserDD
37033>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.FullName to sLoginName
37034>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.LoginName to sLoginName
37035>>>>>        If (not(CreatePasswordHash(Self, Trim(sPassword), &sPassword))) Begin
37037>>>>>            Send Clear of hoUserDD
37038>>>>>            Function_Return False
37039>>>>>        End
37039>>>>>>
37039>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37040>>>>>        Get Request_Validate of hoUserDD to iErr
37041>>>>>        If (iErr) Begin
37043>>>>>            Send Clear of hoUserDD
37044>>>>>            Function_Return False
37045>>>>>        End
37045>>>>>>
37045>>>>>        
37045>>>>>        Send Request_Save of hoUserDD
37046>>>>>        Function_Return (not(Err))
37047>>>>>    End_Function
37048>>>>>    
37048>>>>>    Function UserLogin String sLoginName String sPassword Returns Boolean
37050>>>>>        String sSessionKey sUserPassword
37050>>>>>        Handle hoSessionDD hoUserDD
37050>>>>>        Boolean bMatch bUpgrade
37050>>>>>        
37050>>>>>        Get phoSessionDD to hoSessionDD
37051>>>>>        Get phoUserDD to hoUserDD
37052>>>>>        Integer iErr eLoginMode
37052>>>>>        
37052>>>>>        // Refind session record
37052>>>>>        Get psSessionKey to sSessionKey
37053>>>>>        Send Clear of hoSessionDD
37054>>>>>        Move sSessionKey to WebAppSession.SessionKey
37055>>>>>        Send Find of hoSessionDD EQ Index.1
37056>>>>>        
37056>>>>>        If (Found and WebAppSession.SessionKey = sSessionKey) Begin
37058>>>>>            Get peLoginMode to eLoginMode
37059>>>>>            
37059>>>>>            //  Find the user
37059>>>>>            Move sLoginName to WebAppUser.LoginName
37060>>>>>            Send Find of hoUserDD EQ Index.1
37061>>>>>            
37061>>>>>            // Check username and password
37061>>>>>            If (Found and (Lowercase(sLoginName) = Lowercase(Trim(WebAppUser.LoginName)))) Begin
37063>>>>>                Get Field_Current_Value of hoUserDD Field WebAppUser.Password to sUserPassword
37064>>>>>                Get VerifyPasswordHash (Trim(sUserPassword)) (Trim(sPassword)) (&bUpgrade) to bMatch
37065>>>>>                
37065>>>>>                If (bMatch) Begin
37067>>>>>                    // Store the login
37067>>>>>                    If (bUpgrade) Begin
37069>>>>>                        Get CreatePasswordHash (Trim(sPassword)) (&sPassword) to bUpgrade
37070>>>>>                        If (bUpgrade) Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37073>>>>>                    End
37073>>>>>>
37073>>>>>                    Set Field_Changed_Value of hoUserDD Field WebAppUser.LastLogin to (CurrentDateTime())
37074>>>>>                    Get Request_Validate of hoSessionDD to iErr
37075>>>>>                    If (iErr) Begin
37077>>>>>                        // this should not happen. If it does its a programming error
37077>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37078>>>>>>
37078>>>>>                        Function_Return False
37079>>>>>                    End
37079>>>>>>
37079>>>>>                    
37079>>>>>                    Send Request_Save of hoSessionDD
37080>>>>>                    
37080>>>>>                    // Update session properties
37080>>>>>                    Send UpdateSessionProperties False
37081>>>>>                    Send NotifyChangeRights
37082>>>>>                    Function_Return True
37083>>>>>                End
37083>>>>>>
37083>>>>>                Else Begin
37084>>>>>                    //  We should rely directly on this buffer elsewhere but just be sure
37084>>>>>                    Send Clear of hoUserDD
37085>>>>>                End
37085>>>>>>
37085>>>>>            End
37085>>>>>>
37085>>>>>            Else Begin
37086>>>>>                // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37086>>>>>                Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37087>>>>>            End
37087>>>>>>
37087>>>>>        End
37087>>>>>>
37087>>>>>        Else Begin
37088>>>>>            // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37088>>>>>            Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37089>>>>>        End
37089>>>>>>
37089>>>>>          
37089>>>>>        Function_Return False
37090>>>>>    End_Function
37091>>>>>    
37091>>>>>    Function SetUserPassword String sLoginName String sPassword Returns Boolean
37093>>>>>        Handle hoUserDD
37093>>>>>        Integer iErr
37093>>>>>        Get phoUserDD to hoUserDD
37094>>>>>        
37094>>>>>        //  Find the user
37094>>>>>        Send Clear of hoUserDD
37095>>>>>        Move sLoginName to WebAppUser.LoginName
37096>>>>>        Send Find of hoUserDD EQ Index.1
37097>>>>>        If (not(Found)) Begin
37099>>>>>            Send Clear of hoUserDD
37100>>>>>            Function_Return False
37101>>>>>        End
37101>>>>>>
37101>>>>>        
37101>>>>>        If (not(CreatePasswordHash(Self, Trim(sPassword), &sPassword))) Begin
37103>>>>>            Send Clear of hoUserDD
37104>>>>>            Function_Return False
37105>>>>>        End
37105>>>>>>
37105>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37106>>>>>        Get Request_Validate of hoUserDD to iErr
37107>>>>>        If (iErr) Begin
37109>>>>>            Send Clear of hoUserDD
37110>>>>>            Function_Return False
37111>>>>>        End
37111>>>>>>
37111>>>>>        
37111>>>>>        Send Request_Save of hoUserDD
37112>>>>>        Function_Return (not(Err))
37113>>>>>    End_Function
37114>>>>>    
37114>>>>>    Function IsLoggedIn Returns Boolean
37116>>>>>        String sLoginName
37116>>>>>        Boolean bLogWebSession bLoggedIn
37116>>>>>        
37116>>>>>        Get pbLogWebSession to bLogWebSession
37117>>>>>        If not bLogWebSession Begin
37119>>>>>            Forward Get IsLoggedIn to bLoggedIn
37121>>>>>            Function_Return bLoggedIn
37122>>>>>        End
37122>>>>>>
37122>>>>>        
37122>>>>>        Get psLoginName to sLoginName
37123>>>>>        
37123>>>>>        Function_Return (sLoginName <> "")
37124>>>>>    End_Function
37125>>>>>    
37125>>>>>    
37125>>>>>    //
37125>>>>>    // This procedure is called when validating a session and after logging in. Its purpose is to 
37125>>>>>    // update properties based on the session and user data. Augment this function to update 
37125>>>>>    // properties based on the session / user table. Note that WebAppUser and WebAppSession contain
37125>>>>>    // the right records when this procedure is called.
37125>>>>>    //
37125>>>>>    // Params:
37125>>>>>    //      bClear   True if the procedure is called before session validation to clear properties.
37125>>>>>    //
37125>>>>>    Procedure UpdateSessionProperties Boolean bClear
37127>>>>>        Handle hoUserDD
37127>>>>>        
37127>>>>>        Get phoUserDD to hoUserDD
37128>>>>>        
37128>>>>>        //  Update user properties
37128>>>>>        If (not(bClear) and HasRecord(hoUserDD)) Begin
37130>>>>>            Set psUsername to (Trim(WebAppUser.FullName))
37131>>>>>            Set psLoginName to (Trim(WebAppUser.LoginName))
37132>>>>>            Set piUserRights to WebAppUser.Rights
37133>>>>>            
37133>>>>>            Send OnSessionPropertiesSet 
37134>>>>>        End
37134>>>>>>
37134>>>>>        Else Begin
37135>>>>>            Set psUsername to ""
37136>>>>>            Set psLoginName to ""
37137>>>>>            Set piUserRights to 0
37138>>>>>            
37138>>>>>            Send OnSessionPropertiesClear
37139>>>>>        End
37139>>>>>>
37139>>>>>    End_Procedure
37140>>>>>    
37140>>>>>    Procedure OnSessionPropertiesSet
37142>>>>>        //  Empty event stub
37142>>>>>    End_Procedure
37143>>>>>    
37143>>>>>    Procedure OnSessionPropertiesClear
37145>>>>>        //  Empty event stub
37145>>>>>    End_Procedure
37146>>>>>    
37146>>>>>    Procedure EndSession
37148>>>>>        Integer iErr
37148>>>>>        Boolean bLogWebSession
37148>>>>>        Handle hoSessionDD       
37148>>>>>        
37148>>>>>        Get phoSessionDD to hoSessionDD
37149>>>>>        Get pbLogWebSession to bLogWebSession
37150>>>>>        If not bLogWebSession Begin
37152>>>>>            Forward Send EndSession
37154>>>>>            Procedure_Return
37155>>>>>        End
37155>>>>>>
37155>>>>>            
37155>>>>>        //  Check if session exists
37155>>>>>        Send Clear of hoSessionDD
37156>>>>>        Get psSessionKey to WebAppSession.SessionKey
37157>>>>>        
37157>>>>>        Send Find of hoSessionDD EQ Index.1
37158>>>>>        If (Found) Begin
37160>>>>>            Set Field_Changed_Value of hoSessionDD Field WebAppSession.Active to "N"
37161>>>>>            Get Request_Validate of hoSessionDD to iErr
37162>>>>>            If (iErr) Begin
37164>>>>>                // this should not happen. If it does its a programming error
37164>>>>>                Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37165>>>>>>
37165>>>>>                Procedure_Return
37166>>>>>            End
37166>>>>>>
37166>>>>>            Send Request_Save of hoSessionDD
37167>>>>>        End
37167>>>>>>
37167>>>>>    End_Procedure
37168>>>>>
37168>>>>>End_Class
